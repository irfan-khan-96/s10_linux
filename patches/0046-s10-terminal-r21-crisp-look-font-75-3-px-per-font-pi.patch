From: khan <khan@localhost>
Date: Sat, 7 Nov 2026 12:35:59 +0100
Subject: [PATCH 46/52] s10-terminal r21: crisp look (font 75 = 3 px per font
 pixel, no anti-aliasing, brighter amber)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../s10-terminal/61-s10-vt-crisp.conf         | 11 +++++++++
 device/downstream/s10-terminal/APKBUILD       | 11 +++++----
 device/downstream/s10-terminal/s10-osk        | 23 ++++++++++++-------
 device/downstream/s10-terminal/s10-splash     |  9 ++++----
 device/downstream/s10-terminal/s10-term       |  6 +++--
 5 files changed, 42 insertions(+), 18 deletions(-)
 create mode 100644 device/downstream/s10-terminal/61-s10-vt-crisp.conf

diff --git a/device/downstream/s10-terminal/61-s10-vt-crisp.conf b/device/downstream/s10-terminal/61-s10-vt-crisp.conf
new file mode 100644
index 0000000000..fa297749da
--- /dev/null
+++ b/device/downstream/s10-terminal/61-s10-vt-crisp.conf
@@ -0,0 +1,11 @@
+<?xml version="1.0"?>
+<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
+<!-- S10 VT is a pixel font drawn on a 40-unit grid. At sizes where one font pixel is a whole
+     number of screen pixels (25, 50, 75, 100) it renders exactly without smoothing, so turn
+     anti-aliasing off: hard pixel edges, and cheaper to draw. -->
+<fontconfig>
+  <match target="font">
+    <test name="family"><string>S10 VT</string></test>
+    <edit name="antialias" mode="assign"><bool>false</bool></edit>
+  </match>
+</fontconfig>
