From 405d8b96943d0db8b7ece04dcc4eaea746de0695 Mon Sep 17 00:00:00 2001
From: khan <khan@localhost>
Date: Sat, 7 Nov 2026 18:39:40 +0100
Subject: [PATCH 50/52] s10-terminal r24: Samba listens on all addresses (Wi-Fi
 can come up after it), access still limited to the home network

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 device/downstream/s10-terminal/APKBUILD                  | 4 ++--
 device/downstream/s10-terminal/s10-terminal.post-install | 3 ++-
 device/downstream/s10-terminal/s10-terminal.post-upgrade | 3 ++-
 device/downstream/s10-terminal/smb.conf                  | 9 ++++-----
 4 files changed, 10 insertions(+), 9 deletions(-)

diff --git a/device/downstream/s10-terminal/APKBUILD b/device/downstream/s10-terminal/APKBUILD
index cfcbecb3a4..81f77b0174 100644
--- a/device/downstream/s10-terminal/APKBUILD
+++ b/device/downstream/s10-terminal/APKBUILD
@@ -2,7 +2,7 @@
 # setup that turns samsung-beyond1lte-downstream into a pocket terminal.
 pkgname=s10-terminal
 pkgver=1
-pkgrel=23
+pkgrel=24
 pkgdesc="Galaxy S10 pocket terminal: fbterm + tmux, on-screen keyboard, hardening"
 url="https://postmarketos.org"
 arch="aarch64"
@@ -109,7 +109,7 @@ f5b670528587d518a367b66ae15fd9b5583b7ad666e03051523cf56a1b007469fc5fad535f4d22b1
 36d095a1c678b8107859007b4c34c45ffea2e07a06e6fbaed3616736f13e0e556fffecf69bce551f39fbea00073ea6a4687ea5726c7f61946918ac1849e87896  s10-term
 57a90c056354401584f280ba2e94483dd08dc89fbbd643626f04a1d121ddd0c6a180efb477d863ecd4b2da95325ca8576d355c4467a774c39a08f594978e2675  fbtermrc
 fd54415383f1a8009f3dd726b40dba7dcc4a2f655ecdd6a076cce1de0ecdd2743c5c52ecf0d6b8148b24b9d7284063fd99effd4ea0fc5958073cb1b017b719af  tmux.conf
-220454760959c4c793e6996473e8937abb0064347071d7e62c0318201446d82d28884b13ff072aa2df40378331c4e6a4e411c638930781dd0a58e4ae6f7dd6a9  smb.conf
+3886fa72954bb55b62f9a26a2266f2d4f5e6068a6150827c8f8a56c0c3729a08a287da2071bcc4df4853e7840187e70dfdf03a372882c8f6d067cc58a93ae24c  smb.conf
 c433073ec72b77dbcf13882f7fd92a5915fee1fe3dd3db60fc1e966de7a694e5c63a3b0e2f30689815ae8242d26c2f8807664a9d6c1bcac9d423ff8cd0561f17  05-s10-lpm.start
 2925ca72c125e154331429da14c4b2d515c0cb0b023cae521326f457d098a35ff58c78b5a32e2d950eacd2cb97e086c914e20067577232243c05baf72504df78  10-firewall.start
 0f7f7f1b2d71ca3c5b4082b82ce36f021c96ba8c14db74a4c552b8a931133dabdfdd69628a4d1830e84f2b0b1da40a8624ea100f548f782932fad2ad49846de3  20-display-on.start
diff --git a/device/downstream/s10-terminal/s10-terminal.post-install b/device/downstream/s10-terminal/s10-terminal.post-install
index 2f8398b8ff..f548d5d0ee 100644
--- a/device/downstream/s10-terminal/s10-terminal.post-install
+++ b/device/downstream/s10-terminal/s10-terminal.post-install
@@ -18,9 +18,10 @@ if [ -n "$user" ]; then
 	kill -HUP 1 2>/dev/null
 	# home file share: our config (the stock one stays as smb.conf.orig), its folder, the
 	# service. The Samba password is set by hand once: sudo smbpasswd -a <user>
-	if ! grep -q "S10 home file share" /etc/samba/smb.conf 2>/dev/null; then
+	if ! grep -q "S10 home file share v2" /etc/samba/smb.conf 2>/dev/null; then
 		[ -f /etc/samba/smb.conf ] && [ ! -f /etc/samba/smb.conf.orig ] && cp /etc/samba/smb.conf /etc/samba/smb.conf.orig
 		sed "s/@USER@/$user/g" /usr/share/s10-terminal/smb.conf > /etc/samba/smb.conf
+		rc-service -q samba status && rc-service -q samba restart
 	fi
 	install -d -o "$user" -g "$user" "/home/$user/share"
 	rc-update -q add samba default
diff --git a/device/downstream/s10-terminal/s10-terminal.post-upgrade b/device/downstream/s10-terminal/s10-terminal.post-upgrade
index 2f8398b8ff..f548d5d0ee 100644
--- a/device/downstream/s10-terminal/s10-terminal.post-upgrade
+++ b/device/downstream/s10-terminal/s10-terminal.post-upgrade
@@ -18,9 +18,10 @@ if [ -n "$user" ]; then
 	kill -HUP 1 2>/dev/null
 	# home file share: our config (the stock one stays as smb.conf.orig), its folder, the
 	# service. The Samba password is set by hand once: sudo smbpasswd -a <user>
-	if ! grep -q "S10 home file share" /etc/samba/smb.conf 2>/dev/null; then
+	if ! grep -q "S10 home file share v2" /etc/samba/smb.conf 2>/dev/null; then
 		[ -f /etc/samba/smb.conf ] && [ ! -f /etc/samba/smb.conf.orig ] && cp /etc/samba/smb.conf /etc/samba/smb.conf.orig
 		sed "s/@USER@/$user/g" /usr/share/s10-terminal/smb.conf > /etc/samba/smb.conf
+		rc-service -q samba status && rc-service -q samba restart
 	fi
 	install -d -o "$user" -g "$user" "/home/$user/share"
 	rc-update -q add samba default
diff --git a/device/downstream/s10-terminal/smb.conf b/device/downstream/s10-terminal/smb.conf
index 55285f984f..311da6361d 100644
--- a/device/downstream/s10-terminal/smb.conf
+++ b/device/downstream/s10-terminal/smb.conf
@@ -1,13 +1,12 @@
-# S10 home file share, installed by s10-terminal (the phone user's name is filled in).
-# Home network only: bound to Wi-Fi and loopback, 192.168.178.x clients, SMB2+, no guests.
+# S10 home file share v2, installed by s10-terminal (the phone user's name is filled in).
+# Home network only: listens on all addresses (Wi-Fi may come up after Samba starts), but
+# only 192.168.178.x and loopback clients are allowed; SMB2+, no guests.
 # The firewall (10-firewall.start) also limits port 445 to the home network.
 [global]
 	server role = standalone server
 	workgroup = WORKGROUP
 	server string = Galaxy S10
-	# home network and loopback only; SMB2+ only, no NetBIOS
-	interfaces = lo wlan0
-	bind interfaces only = yes
+	# clients from the home network and loopback only; SMB2+ only, no NetBIOS
 	hosts allow = 127. 192.168.178.
 	server min protocol = SMB2_10
 	disable netbios = yes
-- 
