diff --git a/device/downstream/s10-terminal/smb.conf b/device/downstream/s10-terminal/smb.conf
new file mode 100644
index 0000000000..55285f984f
--- /dev/null
+++ b/device/downstream/s10-terminal/smb.conf
@@ -0,0 +1,27 @@
+# S10 home file share, installed by s10-terminal (the phone user's name is filled in).
+# Home network only: bound to Wi-Fi and loopback, 192.168.178.x clients, SMB2+, no guests.
+# The firewall (10-firewall.start) also limits port 445 to the home network.
+[global]
+	server role = standalone server
+	workgroup = WORKGROUP
+	server string = Galaxy S10
+	# home network and loopback only; SMB2+ only, no NetBIOS
+	interfaces = lo wlan0
+	bind interfaces only = yes
+	hosts allow = 127. 192.168.178.
+	server min protocol = SMB2_10
+	disable netbios = yes
+	smb ports = 445
+	map to guest = never
+	restrict anonymous = 2
+	load printers = no
+	printing = bsd
+	printcap name = /dev/null
+
+[s10]
+	path = /home/@USER@/share
+	valid users = @USER@
+	read only = no
+	browseable = yes
+	create mask = 0644
+	directory mask = 0755
