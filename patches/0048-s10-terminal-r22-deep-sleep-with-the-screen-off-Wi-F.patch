diff --git a/device/downstream/s10-terminal/s10-awake b/device/downstream/s10-terminal/s10-awake
new file mode 100644
index 0000000000..2c91c5aec8
--- /dev/null
+++ b/device/downstream/s10-terminal/s10-awake
@@ -0,0 +1,10 @@
+#!/bin/sh
+# Keep the phone out of deep sleep while a command runs, e.g. s10-awake apk fetch ...
+# (with the screen off the phone otherwise suspends whenever the network is quiet,
+# which pauses everything until a packet, a button or the 15-minute clock wakes it).
+[ $# -gt 0 ] || { echo "usage: s10-awake <command> [args...]"; exit 2; }
+hold="/run/s10-stay-awake/$(id -un).$$"
+: > "$hold" || exit 1
+trap 'rm -f "$hold"' EXIT
+trap 'exit 130' INT TERM HUP
+"$@"
diff --git a/device/downstream/s10-terminal/s10-idle-blank b/device/downstream/s10-terminal/s10-idle-blank
index 9629011c20..3a8fed95fa 100644
--- a/device/downstream/s10-terminal/s10-idle-blank
+++ b/device/downstream/s10-terminal/s10-idle-blank
@@ -8,8 +8,15 @@
 # While the screen is off the phone stays reachable (SSH, Samba) but saves power:
 # the display refresher and screen-only monitors (htop, top) are paused, cores 4-7
 # go offline, Wi-Fi power saving is on, the touch booster and tmux status polling
-# are off. Everything is restored on wake. Battery readings are logged every 5 min
+# are off. Everything is restored on wake. Battery readings are logged every 15 min
 # while off to /var/log/s10-power.log, to check the standby drain.
+#
+# Deep sleep: while the screen is off the phone suspends to RAM whenever nothing holds it
+# awake. The kernel itself refuses to suspend while Wi-Fi traffic is in flight, so an
+# active SSH or Samba session keeps it up; a new packet from the network, a button or the
+# clock (every 15 min, for the battery log and low-battery check) wakes it. Touch does not
+# wake it from sleep; a button does. "0" in /etc/s10-deep-sleep turns sleep off;
+# s10-awake <command> keeps the phone up while a long job runs.
 import glob, os, select, struct, subprocess, time
 
 IDLE = int(os.environ.get("S10_IDLE_SECONDS", "120"))
@@ -27,6 +34,16 @@ BIG_CORES = (4, 5, 6, 7)                       # mid (A75) and big (M4) clusters
 PAUSE_WHEN_OFF = ("msm-fb-refreshe", "htop", "top", "btop")
 FREEZER = "/run/s10-freezer"
 TMUX = ["tmux", "-S", "/tmp/tmux-10000/default"]
+SLEEP_SETTING = "/etc/s10-deep-sleep"          # "0" = never suspend
+STAY_AWAKE = "/run/s10-stay-awake"             # a file in here holds off sleep (s10-awake)
+RTC_ALARM = "/sys/class/rtc/rtc0/wakealarm"
+AWAKE_AFTER_WAKE = 5                           # s up after each wake before trying again
+RETRY = 3                                      # s between refused suspend attempts
+LOG_EVERY = 900                                # s between battery log lines while off
+
+def clock():
+    '''Seconds since boot, counting time spent asleep (time.monotonic stops in suspend).'''
+    return time.clock_gettime(time.CLOCK_BOOTTIME)
 
 def read(path, default=None):
     try:
@@ -103,10 +120,32 @@ def set_blank(off, cycle=True):
     with open(STATE, "w") as f:
         f.write("1" if off else "0")
 
+def suspend(seconds):
+    '''Suspend to RAM with a clock wake-up in `seconds`. Returns True once awake again;
+    False if the kernel refused (a wakeup source was active) or sleep is off or held.'''
+    if read(SLEEP_SETTING, "1") == "0":
+        return False
+    try:
+        if os.listdir(STAY_AWAKE):
+            return False
+    except OSError:
+        pass
+    write(RTC_ALARM, "0")
+    write(RTC_ALARM, f"+{max(int(seconds), 30)}")
+    try:
+        with open("/sys/power/state", "w") as f:
+            f.write("mem")
+        return True
+    except OSError:
+        return False
+    finally:
+        write(RTC_ALARM, "0")
+
 def log_power():
     # this fuel gauge reports current_avg in mA (negative while discharging)
     line = (f"{time.strftime('%Y-%m-%d %H:%M')} {read(BATTERY + '/capacity', '?')}% "
-            f"{read(BATTERY + '/status', '?')} avg {read(BATTERY + '/current_avg', '?')} mA\n")
+            f"{read(BATTERY + '/status', '?')} avg {read(BATTERY + '/current_avg', '?')} mA"
+            f" sleeps {read('/sys/power/suspend_stats/success', '?')}\n")
     try:
         lines = open(POWER_LOG).readlines()[-2000:] if os.path.exists(POWER_LOG) else []
         with open(POWER_LOG, "w") as f:
@@ -122,14 +161,17 @@ def open_inputs(fds):
             except OSError:
                 pass
 
-fds, blanked, last, next_log = {}, False, time.monotonic(), 0
+os.makedirs(STAY_AWAKE, exist_ok=True)
+os.chmod(STAY_AWAKE, 0o1777)                   # any user's s10-awake can hold it
+fds, blanked, last, next_log = {}, False, clock(), 0
+next_sleep = 0
 dimmed = None  # brightness to restore while dimmed
 set_blank(False, cycle=False)
 power_saving(False)
 while True:
     open_inputs(fds)  # pick up hot-plugged keyboards
     # screen off: wake rarely (input still wakes select at once)
-    ready, _, _ = select.select(list(fds.values()), [], [], 60 if blanked else 1)
+    ready, _, _ = select.select(list(fds.values()), [], [], RETRY if blanked else 1)
     activity = power = False
     for fd in ready:
         try:
@@ -146,7 +188,7 @@ while True:
                 power = power or value == 1    # press only; its release is not activity
             elif etype in (EV_KEY, EV_REL, EV_ABS):
                 activity = True
-    now = time.monotonic()
+    now = clock()
     if power and blanked:
         activity = True                        # power button wakes like any key
     if power and not blanked:                  # power button: screen off now
@@ -154,6 +196,7 @@ while True:
         power_saving(True)
         blanked = True
         next_log = now
+        next_sleep = now + 10
     elif activity:
         last = now
         if blanked:
@@ -168,6 +211,7 @@ while True:
         power_saving(True)
         blanked = True
         next_log = now
+        next_sleep = now + 10
     elif not blanked and dimmed is None and now - last >= IDLE - DIM:
         dimmed = backlight()
         if dimmed is not None:
@@ -180,4 +224,9 @@ while True:
         if read(BATTERY + "/status") == "Discharging" and cap.isdigit() and int(cap) <= LOW_BATTERY:
             log_power()
             run("poweroff")
-        next_log = now + 300
+        next_log = now + (LOG_EVERY if blanked else 300)
+    if blanked and not activity and now >= next_sleep:
+        if suspend(next_log - now):
+            next_sleep = clock() + AWAKE_AFTER_WAKE
+        else:
+            next_sleep = clock() + RETRY
diff --git a/device/downstream/s10-terminal/s10-terminal.post-install b/device/downstream/s10-terminal/s10-terminal.post-install
