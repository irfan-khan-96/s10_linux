From ec8a73be07543eb11a1a347b800861643459269f Mon Sep 17 00:00:00 2001
From: Aster Boese <asterboese@mailbox.org>
Date: Tue, 3 Nov 2026 20:15:45 -0500
Subject: [PATCH 034/107] firmware-oneplus-kebab: install to /usr/lib/

/lib/ has been a symlink to /usr/lib/ for quite a while now.
Thus, this change only moves the files in packaging, but on
devices, /usr/lib/ has been the sole path in use.

Signed-off-by: Aster Boese <asterboese@mailbox.org>
Part-of: <https://gitlab.nura.eco/nura/pmaports/-/merge_requests/9880>
---
 device/testing/firmware-oneplus-kebab/APKBUILD | 16 ++++++++--------
 1 file changed, 8 insertions(+), 8 deletions(-)

diff --git a/device/testing/firmware-oneplus-kebab/APKBUILD b/device/testing/firmware-oneplus-kebab/APKBUILD
index f8925558de..b47fe40afa 100644
--- a/device/testing/firmware-oneplus-kebab/APKBUILD
+++ b/device/testing/firmware-oneplus-kebab/APKBUILD
@@ -1,6 +1,6 @@
 maintainer="Frieder Hannenheim <git@fhannenheim.net>"
 pkgname=firmware-oneplus-kebab
-pkgver=1
+pkgver=2
 pkgrel=0
 pkgdesc="Firmware for OnePlus 8T (kebab)"
 url="https://git.sr.ht/~jane400/firmware-oneplus-kebab"
@@ -24,16 +24,16 @@ builddir="$srcdir/firmware-oneplus-kebab-$_commit"
 package() {
 	mkdir -p "$pkgdir"
 
-	install -Dm644 "$builddir/adsp.mbn" -t $pkgdir/lib/firmware/qcom/sm8250/OnePlus/kebab
-	install -Dm644 "$builddir/cdsp.mbn" -t $pkgdir/lib/firmware/qcom/sm8250/OnePlus/kebab
+	install -Dm644 "$builddir/adsp.mbn" -t $pkgdir/usr/lib/firmware/qcom/sm8250/OnePlus/kebab
+	install -Dm644 "$builddir/cdsp.mbn" -t $pkgdir/usr/lib/firmware/qcom/sm8250/OnePlus/kebab
 
-	install -Dm644 "$builddir/a650_zap.mbn" -t $pkgdir/lib/firmware/qcom/sm8250/OnePlus/kebab
+	install -Dm644 "$builddir/a650_zap.mbn" -t $pkgdir/usr/lib/firmware/qcom/sm8250/OnePlus/kebab
 
-	install -Dm644 "$builddir/ipa_fws.mbn" -t $pkgdir/lib/firmware/qcom/sm8250/OnePlus/kebab
-	install -Dm644 "$builddir/ipa_uc.mbn" -t $pkgdir/lib/firmware/qcom/sm8250/OnePlus/kebab
+	install -Dm644 "$builddir/ipa_fws.mbn" -t $pkgdir/usr/lib/firmware/qcom/sm8250/OnePlus/kebab
+	install -Dm644 "$builddir/ipa_uc.mbn" -t $pkgdir/usr/lib/firmware/qcom/sm8250/OnePlus/kebab
 
-	install -Dm644 "$builddir/slpi.mbn" -t $pkgdir/lib/firmware/qcom/sm8250/OnePlus/kebab
-	install -Dm644 "$builddir/venus.mbn" -t $pkgdir/lib/firmware/qcom/sm8250/OnePlus/kebab
+	install -Dm644 "$builddir/slpi.mbn" -t $pkgdir/usr/lib/firmware/qcom/sm8250/OnePlus/kebab
+	install -Dm644 "$builddir/venus.mbn" -t $pkgdir/usr/lib/firmware/qcom/sm8250/OnePlus/kebab
 }
 
 
