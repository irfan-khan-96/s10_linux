+# (Re)start the screen-off daemon and the on-screen keyboard. Run as root.
+# Both are supervised OpenRC services; stop copies started the old way (before r20)
+# first. Exact patterns, so this script never matches itself.
+pkill -f '^/usr/bin/python3 /usr/bin/s10-osk$' 2>/dev/null
+pkill -f '^/usr/bin/python3 /usr/bin/s10-idle-blank$' 2>/dev/null
+rc-service s10-idle-blank restart
+rc-service s10-osk restart
