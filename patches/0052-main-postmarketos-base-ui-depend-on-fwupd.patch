From 1592e4fa551bb2d0e31a6300018be98848ec67b9 Mon Sep 17 00:00:00 2001
From: Achill Gilgenast <achill@achill.org>
Date: Mon, 26 Oct 2026 20:40:37 +0100
Subject: [PATCH 052/107] main/postmarketos-base-ui: depend on fwupd

Moves it from Duranium to all Nura installations, becuase various
(technically all because of USB devices) devices have functionality for fwupd & isn't
specific to Duranium, which we want to offer by default.

This reverts commit 78bc82924b86aeb51879a1a4b5b68f7d7e798ac2.

Part-of: <https://gitlab.nura.eco/nura/pmaports/-/merge_requests/9836>
---
 main/postmarketos-base-ui/APKBUILD  | 3 ++-
 main/postmarketos-duranium/APKBUILD | 3 +--
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/main/postmarketos-base-ui/APKBUILD b/main/postmarketos-base-ui/APKBUILD
index 630451087e..f28ea8caad 100644
--- a/main/postmarketos-base-ui/APKBUILD
+++ b/main/postmarketos-base-ui/APKBUILD
@@ -1,6 +1,6 @@
 maintainer="Clayton Craft <clayton@craftyguy.net>"
 pkgname=postmarketos-base-ui
-pkgver=63
+pkgver=64
 pkgrel=0
 pkgdesc="Meta package for minimal postmarketOS UI base"
 url="https://postmarketos.org"
@@ -10,6 +10,7 @@ depends="
 	avahi
 	chrony
 	dbus
+	fwupd
 	haveged
 	nftables
 	pipewire
diff --git a/main/postmarketos-duranium/APKBUILD b/main/postmarketos-duranium/APKBUILD
index 0b1668c679..af04485e25 100644
--- a/main/postmarketos-duranium/APKBUILD
+++ b/main/postmarketos-duranium/APKBUILD
@@ -1,6 +1,6 @@
 maintainer="Clayton Craft <clayton@craftyguy.net>"
 pkgname=postmarketos-duranium
-pkgver=24
+pkgver=25
 pkgrel=0
 pkgdesc="Configuration for building and booting immutable postmarketOS images"
 url="https://wiki.postmarketos.org/wiki/Duranium_(Immutable_postmarketOS)"
@@ -13,7 +13,6 @@ depends="
 	e2fsprogs
 	erofs-utils
 	f0rmz
-	fwupd
 	postmarketos-base
 	!postmarketos-base-apk
 	postmarketos-base-systemd
-- 
2.53.0

