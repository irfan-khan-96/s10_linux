 2925ca72c125e154331429da14c4b2d515c0cb0b023cae521326f457d098a35ff58c78b5a32e2d950eacd2cb97e086c914e20067577232243c05baf72504df78  10-firewall.start
diff --git a/device/downstream/s10-terminal/s10-osk b/device/downstream/s10-terminal/s10-osk
index 9e6655cb5f..62058aa37b 100755
--- a/device/downstream/s10-terminal/s10-osk
+++ b/device/downstream/s10-terminal/s10-osk
@@ -154,6 +154,26 @@ class Keyboard:
 RESERVE = "/run/s10-osk-reserve"     # pixels fbterm leaves free (FBTERM_RESERVE_FILE)
 SHOWN, HIDDEN_PX = KB_H, 1            # 1, not 0: fbterm keeps scrolling by redraw
 KEY_VOLUMEDOWN = 114
+ROTATE = "/run/s10-rotate"           # fbterm --screen-rotate value, read by s10-term
+LANDSCAPE_CONF = "/etc/s10-landscape"  # 1 = 90° clockwise (default), 3 = counter-clockwise, 0 = off
+
+def landscape_rotation():
+    try:
+        with open(LANDSCAPE_CONF) as f:
+            return int(f.read().split()[0])
+    except (OSError, ValueError, IndexError):
+        return 1
+
+def restart_terminal():
+    """Restart fbterm (inittab respawns s10-term, tmux reattaches); wait until it is back."""
+    old = subprocess.run(["pgrep", "-x", "fbterm"], capture_output=True, text=True).stdout.split()
+    subprocess.run(["pkill", "-x", "fbterm"])
+    for _ in range(50):
+        time.sleep(0.1)
+        new = subprocess.run(["pgrep", "-x", "fbterm"], capture_output=True, text=True).stdout.split()
+        if new and new != old:
+            time.sleep(0.5)                        # fbterm clears the screen as it starts
+            return
 
 def reserved():
     try:
@@ -178,11 +198,13 @@ def hardware_keyboard():
 
 class Visibility:
     """Hide the keyboard while a USB keyboard is attached; Volume Down toggles.
-    fbterm resizes in place on SIGWINCH after reading RESERVE."""
+    fbterm resizes in place on SIGWINCH after reading RESERVE. With a USB keyboard
+    the terminal also turns to landscape (fbterm restarts for that)."""
     def __init__(self, kb):
         self.kb, self.manual, self.next_scan = kb, None, 0
         self.usb = hardware_keyboard()
-        self.visible = reserved() != HIDDEN_PX          # what the running terminal uses
+        self.landscape = os.path.exists(ROTATE)
+        self.visible = reserved() != HIDDEN_PX and not self.landscape   # what the terminal uses
         self.keys_fd = None
         for dev in glob.glob("/sys/class/input/event*"):
             try:
@@ -190,7 +212,9 @@ class Visibility:
                     self.keys_fd = os.open("/dev/input/" + os.path.basename(dev), os.O_RDONLY)
             except OSError:
                 pass
-        if self.visible == self.usb:
+        if self.landscape != (self.usb and landscape_rotation() != 0):
+            self.follow_usb()
+        elif self.visible == self.usb:
             self.apply(not self.usb)
         elif not self.visible:
             self.kb.fb[TOP * LL:(TOP + KB_H) * LL] = bytes(KB_H * LL)   # Keyboard() drew it
@@ -202,12 +226,30 @@ class Visibility:
         usb = hardware_keyboard()
         if usb != self.usb:
             self.usb, self.manual = usb, None          # plugging in or out resets the toggle
-            self.apply(not usb)
+            self.follow_usb()
+
+    def follow_usb(self):
+        """USB keyboard in: keyboard hidden, landscape. Out: portrait, keyboard shown."""
+        rotation = landscape_rotation() if self.usb else 0
+        if rotation:
+            self.apply(False)
+            with open(ROTATE, "w") as f:
+                f.write(str(rotation))
+            self.landscape = True
+            restart_terminal()
+        else:
+            if self.landscape:
+                os.remove(ROTATE)
+                self.landscape = False
+                restart_terminal()
+            self.apply(not self.usb)
 
     def on_button(self, now):
         data = os.read(self.keys_fd, 24 * 16)
         for i in range(0, len(data), 24):
             _, _, etype, code, value = struct.unpack("qqHHi", data[i:i + 24])
+            if self.landscape:                         # the on-screen keyboard is portrait-only
+                continue
             if etype == 1 and code == KEY_VOLUMEDOWN and value == 1 and not screen_waking(now):
                 self.manual = not self.visible
                 self.apply(self.manual)
diff --git a/device/downstream/s10-terminal/s10-term b/device/downstream/s10-terminal/s10-term
index 3a49eafbc1..8fda5f6c32 100644
--- a/device/downstream/s10-terminal/s10-term
+++ b/device/downstream/s10-terminal/s10-term
@@ -1,9 +1,16 @@
 #!/bin/sh
 # Terminal session for tty1: fbterm + tmux above the on-screen keyboard.
 # s10-osk writes the keyboard height (1 while hidden) to the reserve file and
-# sends fbterm SIGWINCH, so fbterm resizes without restarting.
+# sends fbterm SIGWINCH, so fbterm resizes without restarting. With a USB
+# keyboard s10-osk writes the rotation to /run/s10-rotate and restarts fbterm
+# in landscape (no on-screen keyboard there, so nothing is reserved).
 [ -f "$HOME/.fbtermrc" ] || cp /usr/share/s10-terminal/fbtermrc "$HOME/.fbtermrc"
 export TERM=fbterm
 export FBTERM_RESERVE_FILE=/run/s10-osk-reserve
-export FBTERM_RESERVE_BOTTOM="$(cat "$FBTERM_RESERVE_FILE" 2>/dev/null || echo 1100)"
-exec fbterm -- tmux new -A -s main -n menu s10-menu
+rotate="$(cat /run/s10-rotate 2>/dev/null || echo 0)"
+if [ "$rotate" != 0 ]; then
+	export FBTERM_RESERVE_BOTTOM=0
+else
+	export FBTERM_RESERVE_BOTTOM="$(cat "$FBTERM_RESERVE_FILE" 2>/dev/null || echo 1100)"
+fi
+exec fbterm --screen-rotate="$rotate" -- tmux new -A -s main -n menu s10-menu
