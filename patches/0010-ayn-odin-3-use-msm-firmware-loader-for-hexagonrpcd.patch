From 8b7cf97f4ab1f7aee12c3f0708573ff7b2f405ea Mon Sep 17 00:00:00 2001
From: Anton Bambura <jenneron@protonmail.com>
Date: Fri, 23 Oct 2026 19:38:05 +0300
Subject: [PATCH 010/107] ayn-odin-3: use msm-firmware-loader for hexagonrpcd

It still needs its own systemd override because of using
/dev/fastrpc-adsp-secure instead of /dev/fastrpc-adsp, this also makes
it wait for /dev/fastrpc-adsp-secure for 30 seconds instead of exiting
as it takes time to appear on this device.

Part-of: <https://gitlab.nura.eco/nura/pmaports/-/merge_requests/9825>
---
 device/testing/device-ayn-odin-3/APKBUILD                  | 7 ++++---
 .../device-ayn-odin-3/hexagonrpcd-adsp-sensorspd.service   | 7 ++++---
 2 files changed, 8 insertions(+), 6 deletions(-)

diff --git a/device/testing/device-ayn-odin-3/APKBUILD b/device/testing/device-ayn-odin-3/APKBUILD
index 07f9247890..0bc4f939b7 100644
--- a/device/testing/device-ayn-odin-3/APKBUILD
+++ b/device/testing/device-ayn-odin-3/APKBUILD
@@ -2,7 +2,7 @@
 maintainer="Anton Bambura <jenneron@protonmail.com>"
 pkgname=device-ayn-odin-3
 pkgdesc="AYN Odin 3"
-pkgver=4
+pkgver=5
 pkgrel=0
 url="https://postmarketos.org"
 license="MIT"
@@ -19,6 +19,7 @@ depends="
 	linux-firmware-qcom
 	make-dynpart-mappings
 	msm-firmware-loader
+	msm-firmware-loader-hexagonrpcd
 	postmarketos-base
 	soc-qcom
 	soc-qcom-qbootctl
@@ -43,7 +44,7 @@ package() {
 
 	# replace /dev/fastrpc-adsp with /dev/fastrpc-adsp-secure and firmware path
 	install -Dm644 "$srcdir"/hexagonrpcd-adsp-sensorspd.service \
-		"$pkgdir"/usr/lib/systemd/system/hexagonrpcd-adsp-sensorspd.service.d/10-ayn-odin-3.conf
+		"$pkgdir"/usr/lib/systemd/system/hexagonrpcd-adsp-sensorspd.service.d/11-ayn-odin-3.conf
 
 	install -Dm644 "$srcdir"/81-libssc-ayn-odin-3.rules \
 		"$pkgdir"/usr/lib/udev/rules.d/81-libssc-ayn-odin-3.rules
@@ -53,6 +54,6 @@ sha512sums="
 2ed6b63c93007be7a095b708a7f771819dc6bdd39d1c4b2e206973eb1816da20d6d5472d781b860764dbb992380f0d15cd2215f9923cc75cd81c9dadd844376c  81-libssc-ayn-odin-3.rules
 cbf8b067852d79e6a2ef7cdc53cffffef00226189bb5636d64a01689d32201282d5f65c467a62d3806919053a2351a295d9003effcd4825f000637be1fa10276  deviceinfo
 cd73a80bea056ae6e8ff13c2509217afab1bb0a3d3724fe0e7764efb3d48791114aba2327cc71191ee3566d431be28a2b74bf5d2aea2a5104f3733fc37e970da  kernel-cmdline.conf
-e043ac428fa540f5c9095aaa575224da41c97099eadf8bc5d2d0c4e87149f5d869adb896aecd67cb81f869a21ee6b108219a1c86e3d0d9d10d5ac4028a4cd9f5  hexagonrpcd-adsp-sensorspd.service
+d7257d69de53b3be956f93631d92f4afb5776a292788a16d9bc212e11256109fccc72599346b1f726a0f47acfaad8bc941ffd43a264c84ab8c93b6f541d07499  hexagonrpcd-adsp-sensorspd.service
 80590744f7806403c1604f46662a1aa7a756fcb4d94148570cd89d5fd6682c62977c05be0df1a6e219dac7ebef9bd0b4bea82117d7f2ed27028321d604a7addb  modules-initfs
 "
diff --git a/device/testing/device-ayn-odin-3/hexagonrpcd-adsp-sensorspd.service b/device/testing/device-ayn-odin-3/hexagonrpcd-adsp-sensorspd.service
index c1695f15a8..caa570e798 100644
--- a/device/testing/device-ayn-odin-3/hexagonrpcd-adsp-sensorspd.service
+++ b/device/testing/device-ayn-odin-3/hexagonrpcd-adsp-sensorspd.service
@@ -1,10 +1,11 @@
 [Unit]
+# dont wait for /dev/fastrpc-sdsp
 ConditionPathExists=
-ConditionPathExists=!/dev/fastrpc-sdsp
-ConditionPathExists=/dev/fastrpc-adsp-secure
 Requires=msm-firmware-loader.service
 After=msm-firmware-loader.service
 
 [Service]
+# it takes time for /dev/fastrpc-adsp-secure to appear
+ExecStartPre=/usr/bin/udevadm wait --timeout=30 /dev/fastrpc-adsp-secure
 ExecStart=
-ExecStart=/usr/bin/hexagonrpcd -f /dev/fastrpc-adsp-secure -d adsp -s -R /usr/share/qcom/sm8750/ayn/odin-3
+ExecStart=/usr/bin/hexagonrpcd -f /dev/fastrpc-adsp-secure -d adsp -s -R /run/msm-firmware-loader/hexagonrpc
-- 
2.53.0

