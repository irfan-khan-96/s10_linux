index 5c3e159e79..8f4b7fedcc
--- a/device/downstream/s10-terminal/s10-term
+++ b/device/downstream/s10-terminal/s10-term
@@ -22,5 +22,6 @@ palette='0;0;0;0 1;204;102;102 2;181;189;104 3;240;198;116 4;129;162;190 5;178;1
 12;122;166;218 13;195;151;216 14;112;192;177 15;234;234;234'
 seq=""
 for c in $palette; do seq="$seq\033[3;$c}"; done
+# fbterm hands its child TERM=linux (8 colours); tmux must see TERM=fbterm (256 colours).
 exec fbterm --screen-rotate="$rotate" --font-size="$size" -- \
-	sh -c "printf '$seq\033[2J'; exec tmux new -A -s main -n menu s10-menu"
+	sh -c "printf '$seq\033[2J'; TERM=fbterm exec tmux new -A -s main -n menu s10-menu"
