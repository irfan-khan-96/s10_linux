new mode 100644
index c8b89596e4..962b060511
--- a/device/downstream/s10-terminal/tmux.conf
+++ b/device/downstream/s10-terminal/tmux.conf
@@ -1,5 +1,7 @@
 # Clean, fast tmux for the S10 terminal
 set -g default-terminal "tmux-256color"
+# fbterm's "oc" (ESC ] R) resets its palette, which would undo the s10 colours
+set -as terminal-overrides ",fbterm:oc@"
 set -sg escape-time 0
 set -g history-limit 20000
 set -g base-index 1
