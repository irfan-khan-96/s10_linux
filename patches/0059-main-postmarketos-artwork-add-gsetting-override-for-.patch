From dfe2176ff3555dc1963d07fc5e3aa608db85097d Mon Sep 17 00:00:00 2001
From: Luca Weiss <luca@lucaweiss.eu>
Date: Thu, 5 Nov 2026 20:17:25 +0100
Subject: [PATCH 059/107] main/postmarketos-artwork: add gsetting override for
 Lomiri wallpaper

Since Lomiri 0.6.0, it's no longer using the GNOME namespace for
wallpaper but a custom namespace. Therefore the wallpaper was falling
back to the default wallpaper (which isn't installed).

Set the Lomiri wallpaper in the same file so we don't have to add yet
another file to update when the wallpaper changes.

See also: https://gitlab.com/ubports/development/core/lomiri/-/merge_requests/138

Part-of: <https://gitlab.nura.eco/nura/pmaports/-/merge_requests/9891>
---
 .../postmarketos-artwork/10_pmOS-wallpaper.gschema.override | 6 ++++++
 main/postmarketos-artwork/APKBUILD                          | 4 ++--
 2 files changed, 8 insertions(+), 2 deletions(-)

diff --git a/main/postmarketos-artwork/10_pmOS-wallpaper.gschema.override b/main/postmarketos-artwork/10_pmOS-wallpaper.gschema.override
index 4d0bc7e76c..8e96d4afcb 100644
--- a/main/postmarketos-artwork/10_pmOS-wallpaper.gschema.override
+++ b/main/postmarketos-artwork/10_pmOS-wallpaper.gschema.override
@@ -9,3 +9,9 @@ picture-uri-dark='file:///usr/share/wallpapers/postmarketos/contents/images_dark
 [org.gnome.desktop.screensaver:Phosh]
 picture-options='zoom'
 picture-uri='file:///usr/share/wallpapers/postmarketos/contents/images/2000x2000.png'
+
+[com.lomiri.Shell]
+background-picture-uri='file:///usr/share/wallpapers/postmarketos/contents/images/2000x2000.png'
+
+[com.lomiri.Shell.Greeter]
+background-picture-uri='file:///usr/share/wallpapers/postmarketos/contents/images/2000x2000.png'
diff --git a/main/postmarketos-artwork/APKBUILD b/main/postmarketos-artwork/APKBUILD
index 1d9e6eb9fc..3b90426f31 100644
