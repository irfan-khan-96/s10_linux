From 814e1f92e188db0dfad8c355dbadddd42ad2d3d1 Mon Sep 17 00:00:00 2001
From: khan <khan@localhost>
Date: Mon, 2 Nov 2026 01:07:02 +0100
Subject: [PATCH 33/43] fbterm: rebuild fill colours when palette entries
 change

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 main/fbterm/APKBUILD              |  4 +++-
 main/fbterm/palette-refresh.patch | 13 +++++++++++++
 2 files changed, 16 insertions(+), 1 deletion(-)
 create mode 100644 main/fbterm/palette-refresh.patch

diff --git a/main/fbterm/APKBUILD b/main/fbterm/APKBUILD
index af16beecde..a660834ae2 100644
--- a/main/fbterm/APKBUILD
+++ b/main/fbterm/APKBUILD
@@ -1,7 +1,7 @@
 # Local package for the S10 fork: fbterm with Debian's patches
 pkgname=fbterm
 pkgver=1.7
-pkgrel=2
+pkgrel=3
 _debrel=5
 pkgdesc="Fast framebuffer terminal emulator with TrueType fonts"
 url="https://salsa.debian.org/debian/fbterm"
@@ -15,6 +15,7 @@ source="https://deb.debian.org/debian/pool/main/f/fbterm/fbterm_$pkgver.orig.tar
 	musl-compat.patch
 	reserve-bottom.patch
 	live-resize.patch
+	palette-refresh.patch
 	"
 builddir="$srcdir/fbterm-$pkgver"
 
@@ -47,4 +48,5 @@ sha512sums="
 a9f23806626bd2accf4b50e759f9cd6b4076353938c74ba6d1f461465754cebd47b7923e7c183ecea164fb8ae573a4f5e06c75be5222ec58176912b2e298c6fd  musl-compat.patch
 766fa8a23d416f3f79da8ce947e89ed2ae17c823b618ae90f47231046f156053bc905ce2724247d3223ab03c96ec7aa12a83c54a4d3866d441336dab1622ad98  reserve-bottom.patch
 d7fbfa9f42972bd03aba3e51b8b2c6cdc7c46d4597f1972cf05bdfe1a2a4b9e4645eb07bb3a53f4122929a08f0bbf7db6d2ddfe079b564c3d211c90356f6427e  live-resize.patch
+9716a762d62c9b37e6eb5e32449fb83f3f612a6d169133c048850d2e92c209eaf416e295a49619abf32edabacf4acbf1efa07ba3ca292539a068098f3355b9bf  palette-refresh.patch
 "
diff --git a/main/fbterm/palette-refresh.patch b/main/fbterm/palette-refresh.patch
new file mode 100644
index 0000000000..ae3284945b
--- /dev/null
+++ b/main/fbterm/palette-refresh.patch
@@ -0,0 +1,13 @@
+diff --git a/src/screen_render.cpp b/src/screen_render.cpp
+index e8f39b8..53b9297 100644
+--- a/src/screen_render.cpp
++++ b/src/screen_render.cpp
+@@ -36,7 +36,7 @@ static u8 bgcolor;
+ 
+ void Screen::setPalette(const Color *palette)
+ {
+-	if (mPalette == palette) return;
++	/* no early return for the same palette: its entries may have changed */
+ 	mPalette = palette;
+ 
+ 	for (u32 i = 0; i < NR_COLORS; i++) {
-- 
