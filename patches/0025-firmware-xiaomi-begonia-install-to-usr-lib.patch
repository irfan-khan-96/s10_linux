From 0d6405842f6737d1a2736b9f97b320df3b646f05 Mon Sep 17 00:00:00 2001
From: Aster Boese <asterboese@mailbox.org>
Date: Fri, 30 Oct 2026 13:03:48 -0400
Subject: [PATCH 025/107] firmware-xiaomi-begonia: install to /usr/lib/

/lib/ has been a symlink to /usr/lib/ for quite a while now.
Thus, this change only moves the files in packaging, but on
devices, /usr/lib/ has been the sole path in use.

Signed-off-by: Aster Boese <asterboese@mailbox.org>
Part-of: <https://gitlab.nura.eco/nura/pmaports/-/merge_requests/9851>
---
 .../testing/firmware-xiaomi-begonia/10-touch-firmware.files | 2 +-
 device/testing/firmware-xiaomi-begonia/APKBUILD             | 6 +++---
 2 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/device/testing/firmware-xiaomi-begonia/10-touch-firmware.files b/device/testing/firmware-xiaomi-begonia/10-touch-firmware.files
index 29169e6351..2550899c88 100644
--- a/device/testing/firmware-xiaomi-begonia/10-touch-firmware.files
+++ b/device/testing/firmware-xiaomi-begonia/10-touch-firmware.files
@@ -1 +1 @@
-/lib/firmware/novatek/nt36672a_begonia_csot.bin.zst
+/usr/lib/firmware/novatek/nt36672a_begonia_csot.bin.zst
diff --git a/device/testing/firmware-xiaomi-begonia/APKBUILD b/device/testing/firmware-xiaomi-begonia/APKBUILD
index 616e36ca18..89fda03260 100644
--- a/device/testing/firmware-xiaomi-begonia/APKBUILD
+++ b/device/testing/firmware-xiaomi-begonia/APKBUILD
@@ -1,7 +1,7 @@
 maintainer="Dinolek <git@dinolek.me>"
 pkgname=firmware-xiaomi-begonia
 pkgver=20250810
-pkgrel=0
+pkgrel=1
 pkgdesc="Firmware for Xiaomi Redmi Note 8 Pro"
 subpackages="
 	$pkgname-touchscreen
@@ -26,12 +26,12 @@ touchscreen() {
 	pkgdesc="Xiaomi Redmi Note 8 Pro touchscreen firmware"
 
 	install -Dm644 "$builddir/novatek/nt36672a_begonia_csot.bin.zst" -t \
-		"$subpkgdir/lib/firmware/novatek/"
+		"$subpkgdir/usr/lib/firmware/novatek/"
 	install -Dm644 "$srcdir/10-touch-firmware.files" -t \
 		"$subpkgdir/usr/share/mkinitfs/files/"
 }
 
 sha512sums="
 230a2acca5cf5d179c30338416dad01c14c0e8bf73e8034855c39a16757394c0d0fb8b924eead93cc873ffe50ba97faf5c3aea9034ac3ba31ff55c04185a9f80  firmware-d62a654f9f84344571cbf5a306d33869d49aa70b.tar.gz
-a8373ff6265c21be1aef1b5ccd0a0b419887864e5609b99ef0af96cdb0079c3a099fbbd6242fc3e95f89bb5b096119bd3e3ef232741700cf05b33a079d6aba1f  10-touch-firmware.files
+66916979325c0fd382564dcfefc30491dfd416a258da5a04bb8aacf4b8ca9a1a3bfefad6c2d0279f979ca9ef6ce5eb2fe47447a7762d0fcadbf85a7af5198298  10-touch-firmware.files
 "
