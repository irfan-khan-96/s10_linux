From d73c1f23f6cda377ba0baf96c5181bb1755a3d07 Mon Sep 17 00:00:00 2001
From: khan <khan@localhost>
Date: Sat, 7 Nov 2026 12:46:05 +0100
Subject: [PATCH 47/47] fbterm r5: place glyphs by their rendered bitmap (sharp
 monochrome text)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 main/fbterm/APKBUILD           |  4 +++-
 main/fbterm/glyph-bitmap.patch | 19 +++++++++++++++++++
 2 files changed, 22 insertions(+), 1 deletion(-)
 create mode 100644 main/fbterm/glyph-bitmap.patch

diff --git a/main/fbterm/APKBUILD b/main/fbterm/APKBUILD
index 4de7c78d98..988b81074b 100644
--- a/main/fbterm/APKBUILD
+++ b/main/fbterm/APKBUILD
@@ -1,7 +1,7 @@
 # Local package for the S10 fork: fbterm with Debian's patches
 pkgname=fbterm
 pkgver=1.7
-pkgrel=4
+pkgrel=5
 _debrel=5
 pkgdesc="Fast framebuffer terminal emulator with TrueType fonts"
 url="https://salsa.debian.org/debian/fbterm"
@@ -17,6 +17,7 @@ source="https://deb.debian.org/debian/pool/main/f/fbterm/fbterm_$pkgver.orig.tar
 	live-resize.patch
 	palette-refresh.patch
 	scanlines.patch
+	glyph-bitmap.patch
 	"
 builddir="$srcdir/fbterm-$pkgver"
 
@@ -51,4 +52,5 @@ a9f23806626bd2accf4b50e759f9cd6b4076353938c74ba6d1f461465754cebd47b7923e7c183ece
 d7fbfa9f42972bd03aba3e51b8b2c6cdc7c46d4597f1972cf05bdfe1a2a4b9e4645eb07bb3a53f4122929a08f0bbf7db6d2ddfe079b564c3d211c90356f6427e  live-resize.patch
 9716a762d62c9b37e6eb5e32449fb83f3f612a6d169133c048850d2e92c209eaf416e295a49619abf32edabacf4acbf1efa07ba3ca292539a068098f3355b9bf  palette-refresh.patch
 e9c3933f38614124d26696929deec42848291172077cceb0ae09dd651f49dacb906630acf34c524fc7f14373a857d50ff9b5e47d19a3b71d1b51545e3d2c65b5  scanlines.patch
+0b8c99841e5d4c6547e2c6652772275d7f61d3f1373e50036c324ffbdf032a4e0722c696fb00d54c57dfcb9083da5dcd0dbc941c7912293e1e9093f7ebc3717b  glyph-bitmap.patch
 "
diff --git a/main/fbterm/glyph-bitmap.patch b/main/fbterm/glyph-bitmap.patch
new file mode 100644
index 0000000000..84dc70703f
--- /dev/null
+++ b/main/fbterm/glyph-bitmap.patch
@@ -0,0 +1,19 @@
+--- a/src/font.cpp	2026-11-07 12:46:04.629723359 +0100
++++ b/src/font.cpp	2026-11-07 12:46:04.661870859 +0100
+@@ -307,10 +307,12 @@
+ 	Screen::instance()->rotateRect(x, y, nw, nh);
+ 
+ 	Glyph *glyph = (Glyph *)new u8[OFFSET(Glyph, pixmap) + nw * nh];
+-	glyph->left = face->glyph->metrics.horiBearingX >> 6;
+-	glyph->top = mHeight - 1 + (face->size->metrics.descender >> 6) - (face->glyph->metrics.horiBearingY >> 6);
+-	glyph->width = face->glyph->metrics.width >> 6;
+-	glyph->height = face->glyph->metrics.height >> 6;
++	// the rendered bitmap's own offset and size (the outline metrics can differ by a pixel,
++	// most of all for monochrome glyphs, and clipping to them cut strokes)
++	glyph->left = face->glyph->bitmap_left;
++	glyph->top = mHeight - 1 + (face->size->metrics.descender >> 6) - face->glyph->bitmap_top;
++	glyph->width = w;
++	glyph->height = h;
+ 	glyph->pitch = nw;
+ 
+ 	u8 *buf = bitmap.buffer;
-- 
