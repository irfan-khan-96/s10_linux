From 645c2a83a62d7ef2d8f168bf1280c6fbefd76db5 Mon Sep 17 00:00:00 2001
From: khan <khan@localhost>
Date: Sun, 1 Nov 2026 22:13:41 +0100
Subject: [PATCH 20/23] s10-terminal: keyboard state follows the running
 terminal at startup

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 device/downstream/s10-terminal/APKBUILD | 2 +-
 device/downstream/s10-terminal/s10-osk  | 6 ++++--
 2 files changed, 5 insertions(+), 3 deletions(-)

diff --git a/device/downstream/s10-terminal/APKBUILD b/device/downstream/s10-terminal/APKBUILD
index 7bd58f297e..025ceedb33 100644
--- a/device/downstream/s10-terminal/APKBUILD
+++ b/device/downstream/s10-terminal/APKBUILD
@@ -65,7 +65,7 @@ package() {
 }
 
 sha512sums="
-dab52714e08010fe7d2c2089a07ef15893709fa01e70ff2bf651f750d102eb2c22f4be0540af9958fd4121ba579a5d2b215c39b150eb643476750b0801ca0a56  s10-osk
+4c10f19fd209c2942d085e22394b05385d309308d87a20af063c4a740fd56f8b4e2df93b5aad1adb5eb4a6cd8f5e8fb89cd3a45a743fc4841fe3bbb84cd31aa2  s10-osk
 d3f73cfc060ad3222521699ba980d4ade218bf2ee8b9681bd6abebd8300602bca3283eb0cabce74792355741d8812f2f1753e16b540b229812a4c404a95cec0a  s10-idle-blank
 f5b670528587d518a367b66ae15fd9b5583b7ad666e03051523cf56a1b007469fc5fad535f4d22b12106042e93352b07594ec6dbc4da50766b3757d6e103f12b  s10-touch-absfix
 9daf9ac5a89cd6d83560f26e35b95253ea71b20eeb3556ebdf31e2b7e4a66dfa4845c0f73c43601ac63f2e56613f17777691135d564f4924f23b9a3865838e6f  s10-osk-start
diff --git a/device/downstream/s10-terminal/s10-osk b/device/downstream/s10-terminal/s10-osk
index a5b2f2c63d..b572326aad 100755
--- a/device/downstream/s10-terminal/s10-osk
+++ b/device/downstream/s10-terminal/s10-osk
@@ -174,7 +174,7 @@ class Visibility:
     def __init__(self, kb):
         self.kb, self.manual, self.next_scan = kb, None, 0
         self.usb = hardware_keyboard()
-        self.visible = True
+        self.visible = not os.path.exists(HIDDEN)      # what the running terminal uses
         self.keys_fd = None
         for dev in glob.glob("/sys/class/input/event*"):
             try:
@@ -182,7 +182,9 @@ class Visibility:
                     self.keys_fd = os.open("/dev/input/" + os.path.basename(dev), os.O_RDONLY)
             except OSError:
                 pass
-        self.apply(not self.usb, restart_terminal=os.path.exists(HIDDEN) == (not self.usb))
+        self.apply(not self.usb, restart_terminal=False)
+        if not self.visible:
+            self.kb.fb[TOP * LL:(TOP + KB_H) * LL] = bytes(KB_H * LL)
 
     def poll(self, now):
         if now < self.next_scan:
-- 
