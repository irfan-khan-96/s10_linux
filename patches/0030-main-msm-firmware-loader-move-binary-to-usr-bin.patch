From d45b1b8c117ef8b8445fa733f26ed22c864d905e Mon Sep 17 00:00:00 2001
From: Aster Boese <asterboese@mailbox.org>
Date: Tue, 3 Nov 2026 16:29:15 -0500
Subject: [PATCH 030/107] main/msm-firmware-loader: move binary to usr/bin

Now with Nura bin-merged, usr/sbin points to usr/bin, so installing to
usr/bin directly is correct.

Signed-off-by: Aster Boese <asterboese@mailbox.org>
Part-of: <https://gitlab.nura.eco/nura/pmaports/-/merge_requests/9769>
---
 main/msm-firmware-loader/APKBUILD | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/main/msm-firmware-loader/APKBUILD b/main/msm-firmware-loader/APKBUILD
index 9c09e9d027..0a0929ec21 100644
--- a/main/msm-firmware-loader/APKBUILD
+++ b/main/msm-firmware-loader/APKBUILD
@@ -1,7 +1,7 @@
 maintainer="Stefan Hansson <newbyte@postmarketos.org>"
 pkgname=msm-firmware-loader
 pkgver=1.9.0
-pkgrel=0
+pkgrel=1
 pkgdesc="Set of init services to automatically load firmware from device partitions"
 url="https://postmarketos.org/"
 subpackages="
@@ -26,9 +26,9 @@ options="!check"
 
 package() {
 	install -Dm755 msm-firmware-loader.sh \
-		"$pkgdir/usr/sbin/msm-firmware-loader.sh"
+		"$pkgdir/usr/bin/msm-firmware-loader.sh"
 	install -Dm755 msm-firmware-loader-unpack.sh \
-		"$pkgdir/usr/sbin/msm-firmware-loader-unpack.sh"
+		"$pkgdir/usr/bin/msm-firmware-loader-unpack.sh"
 
 	install -Dm755 msm-firmware-loader.initd \
 		"$pkgdir/etc/init.d/msm-firmware-loader"
-- 
2.53.0

