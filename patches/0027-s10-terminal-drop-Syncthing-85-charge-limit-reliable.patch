diff --git a/device/downstream/s10-terminal/s10-idle-blank b/device/downstream/s10-terminal/s10-idle-blank
index f1e3897935..def7772bb3 100755
--- a/device/downstream/s10-terminal/s10-idle-blank
+++ b/device/downstream/s10-terminal/s10-idle-blank
@@ -8,9 +8,19 @@ BLANK = "/sys/class/graphics/fb0/blank"
 
 STATE = "/run/s10-blanked"  # "1" while off, "0" just after waking (read by s10-osk)
 
-def set_blank(off):
+def write_blank(value):
     with open(BLANK, "w") as f:
-        f.write("1" if off else "0")
+        f.write(value)
+
+def set_blank(off):
+    if off:
+        write_blank("1")
+    else:
+        # A plain unblank after a long blank can leave the panel dark (the driver
+        # accepts it but DSIM stays off); off, a short pause, then on wakes it.
+        write_blank("1")
+        time.sleep(0.3)
+        write_blank("0")
     with open(STATE, "w") as f:
         f.write("1" if off else "0")
 
diff --git a/device/downstream/s10-terminal/s10-syncthing-setup b/device/downstream/s10-terminal/s10-syncthing-setup
deleted file mode 100644
index a72cc22077..0000000000
--- a/device/downstream/s10-terminal/s10-syncthing-setup
+++ /dev/null
@@ -1,20 +0,0 @@
-#!/bin/sh
-# Run as the phone user once Syncthing is up: keep it on the home network only
-# and make sure the shared folders exist. Safe to run again.
-H="$HOME/.config/syncthing"
-st() { syncthing cli --home="$H" "$@"; }
-mkdir -p "$HOME/notes" "$HOME/journal"
-st config options global-ann-enabled set false
-st config options relays-enabled set false
-st config options natenabled set false
-st config options uraccepted set -- -1
-st config options auto-upgrade-intervalh set 0
-# crash reporting has no cli option; use the local REST API
-python3 - "$(st config gui apikey get)" <<'EOF'
-import sys, urllib.request
-req = urllib.request.Request("http://127.0.0.1:8384/rest/config/options", method="PATCH",
-    data=b'{"crashReportingEnabled": false}',
-    headers={"X-API-Key": sys.argv[1], "Content-Type": "application/json"})
-urllib.request.urlopen(req)
-EOF
-echo "Device ID: $(st show system | sed -n 's/.*"myID": "\(.*\)".*/\1/p')"
diff --git a/device/downstream/s10-terminal/s10-syncthing.initd b/device/downstream/s10-terminal/s10-syncthing.initd
deleted file mode 100644
index 26c7b8f657..0000000000
--- a/device/downstream/s10-terminal/s10-syncthing.initd
+++ /dev/null
@@ -1,15 +0,0 @@
-#!/sbin/openrc-run
-# Syncthing as the phone user (uid 10000) for ~/notes and ~/journal.
-# GUI/API on 127.0.0.1 only; discovery and relays are off (see s10-syncthing-setup).
-description="Syncthing for the phone user, home network only"
-user=$(getent passwd 10000 | cut -d: -f1)
-supervisor=supervise-daemon
-command=/usr/bin/syncthing
-command_args="serve --no-browser --home=/home/$user/.config/syncthing --gui-address=127.0.0.1:8384"
-command_user="$user:$user"
-supervise_daemon_args="--env HOME=/home/$user --env STNODEFAULTFOLDER=1"
-
-depend() {
-	need net
-	after firewall local
-}
