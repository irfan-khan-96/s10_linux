From d23e44d1b6af527dcfcf77c4c26f6c6aac4fbea8 Mon Sep 17 00:00:00 2001
From: Yu Watanabe <watanabe.yu+github@gmail.com>
Date: Wed, 21 Oct 2026 07:51:35 +0900
Subject: [PATCH 006/107] systemd: fix path to setfont

Since kbd-2.0.2~r1, the setfont command has been installed under
/usr/sbin rather than /usr/bin [1].

[1] https://gitlab.alpinelinux.org/alpine/aports/-/commit/56305e26568b93ae7e57231b52b5dd13fb32fadb

Part-of: <https://gitlab.nura.eco/nura/pmaports/-/merge_requests/9779>
---
 extra-repos/systemd/systemd/APKBUILD | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/extra-repos/systemd/systemd/APKBUILD b/extra-repos/systemd/systemd/APKBUILD
index f8c1a8228b..a3b561e999 100644
--- a/extra-repos/systemd/systemd/APKBUILD
+++ b/extra-repos/systemd/systemd/APKBUILD
@@ -262,7 +262,7 @@ build() {
 		-Dmount-path=/bin/mount \
 		-Dumount-path=/bin/umount \
 		-Dloadkeys-path=/usr/bin/loadkeys \
-		-Dsetfont-path=/usr/bin/setfont \
+		-Dsetfont-path=/usr/sbin/setfont \
 		-Dnologin-path=/sbin/nologin \
 		\
 		-Dldconfig=false \
-- 
2.53.0

