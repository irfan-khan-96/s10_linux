+index 9d538cb..6c2c603 100644
+--- a/src/fbterm.cpp
++++ b/src/fbterm.cpp
+@@ -134,6 +134,7 @@ void FbTerm::init()
+ 	sigaddset(&sigmask, SIGALRM);
+ 	sigaddset(&sigmask, SIGTERM);
+ 	sigaddset(&sigmask, SIGHUP);
++	sigaddset(&sigmask, SIGWINCH);
+ 
+ 	sigprocmask(SIG_BLOCK, &sigmask, &oldSigmask);
+ 	new SignalIo(sigmask);
+@@ -146,6 +147,7 @@ void FbTerm::init()
+ 	signal(SIGALRM, sh);
+ 	signal(SIGTERM, sh);
+ 	signal(SIGHUP, sh);
++	signal(SIGWINCH, sh);
+ #endif
+ 	signal(SIGPIPE, SIG_IGN);
+ 
+@@ -211,6 +213,20 @@ void FbTerm::processSignal(u32 signo)
+ 		FbShellManager::instance()->switchVc(true);
+ 		break;
+ 
++	case SIGWINCH: {
++		/* FBTERM_RESERVE_FILE: re-read the reserved bottom strip (pixels) */
++		const char *path = getenv("FBTERM_RESERVE_FILE");
++		FILE *f = path ? fopen(path, "r") : 0;
++		if (f) {
++			unsigned long reserved;
++			if (fscanf(f, "%lu", &reserved) == 1 && Screen::instance()->setReserved(reserved)) {
++				FbShellManager::instance()->resize();
++			}
++			fclose(f);
++		}
++		break;
++	}
++
+ 	case SIGCHLD:
+ 		if (mRun) {
+ 			s32 pid = waitpid(WAIT_ANY, 0, WNOHANG);
+diff --git a/src/screen.cpp b/src/screen.cpp
+index 4da2453..a6efc67 100644
+--- a/src/screen.cpp
++++ b/src/screen.cpp
+@@ -92,7 +92,7 @@ Screen *Screen::createInstance()
+ 
+ Screen::Screen()
+ {
+-	mWidth = mHeight = 0;
++	mWidth = mHeight = mFullHeight = 0;
+ 	mCols = mRows = 0;
+ 	mBitsPerPixel = mBytesPerLine = 0;
+ 
+@@ -394,3 +394,22 @@ void Screen::rotatePoint(u32 W, u32 H, u32 &x, u32 &y)
+ 		break;
+ 	}
+ }
++
++/*
++ * Change the strip left free at the bottom (FBTERM_RESERVE_BOTTOM) while
++ * running. Only without rotation and with redraw scrolling, which is what a
++ * reserved strip uses. Returns true if the number of rows may have changed.
++ */
++bool Screen::setReserved(u32 reserved)
++{
++	if (!mFullHeight || mRotateType != Rotate0 || mScrollType != Redraw) return false;
++	if (reserved >= mFullHeight) reserved = 0;
++
++	u32 height = mFullHeight - reserved;
++	if (height == mHeight || height < FH(1)) return false;
++
++	mHeight = height;
++	mRows = mHeight / FH(1);
++	fillRect(0, FH(mRows), mWidth, mHeight - FH(mRows), 0);
++	return true;
++}
+diff --git a/src/screen.h b/src/screen.h
+index 136d1e2..f011861 100644
+--- a/src/screen.h
++++ b/src/screen.h
+@@ -52,12 +52,13 @@ public :
+ 	void setPalette(const Color *palette);
+ 	
+ 	void enableScroll(bool enable) { mScrollEnable = enable; }
++	bool setReserved(u32 reserved);
+ 
+ 	void showInfo(bool verbose);
+ 	virtual void switchVc(bool enter);
+ 
+ protected:
+-	u32 mWidth, mHeight;
++	u32 mWidth, mHeight, mFullHeight;
+ 	u16 mCols, mRows;
+ 	u32 mBitsPerPixel, mBytesPerLine;
+ 
