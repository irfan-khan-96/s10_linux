@@ -0,0 +1,139 @@
+diff --git a/src/fbdev.cpp b/src/fbdev.cpp
+index 0e402ca..ac7712b 100644
+--- a/src/fbdev.cpp
++++ b/src/fbdev.cpp
+@@ -100,6 +100,7 @@ FbDev::FbDev()
+ 	const char *reserve = getenv("FBTERM_RESERVE_BOTTOM");
+ 	u32 reserved = reserve ? strtoul(reserve, 0, 10) : 0;
+ 	if (reserved >= mHeight) reserved = 0;
++	mFullHeight = mHeight;
+ 	mHeight -= reserved;
+ 	mBitsPerPixel = vinfo.bits_per_pixel;
+ 	mBytesPerLine = finfo.line_length;
+diff --git a/src/fbshellman.cpp b/src/fbshellman.cpp
