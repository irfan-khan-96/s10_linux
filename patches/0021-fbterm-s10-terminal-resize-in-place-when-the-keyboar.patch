 a9f23806626bd2accf4b50e759f9cd6b4076353938c74ba6d1f461465754cebd47b7923e7c183ecea164fb8ae573a4f5e06c75be5222ec58176912b2e298c6fd  musl-compat.patch
 766fa8a23d416f3f79da8ce947e89ed2ae17c823b618ae90f47231046f156053bc905ce2724247d3223ab03c96ec7aa12a83c54a4d3866d441336dab1622ad98  reserve-bottom.patch
+3045a74b989a1a4434e44a6469e47f6c47076627bc027804814fcd6dd47a7635c73e72ceb92610f0f937e3b0eaa5040c4f97dfc98f7e3264dfbf7482ccb7a445  live-resize.patch
