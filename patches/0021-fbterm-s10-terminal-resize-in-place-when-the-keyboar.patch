diff --git a/device/downstream/s10-terminal/s10-osk b/device/downstream/s10-terminal/s10-osk
index b572326aad..9e6655cb5f 100755
--- a/device/downstream/s10-terminal/s10-osk
+++ b/device/downstream/s10-terminal/s10-osk
@@ -151,9 +151,17 @@ class Keyboard:
         except OSError:
             pass
 
-HIDDEN = "/run/s10-osk-hidden"              # read by s10-term: full-height terminal
+RESERVE = "/run/s10-osk-reserve"     # pixels fbterm leaves free (FBTERM_RESERVE_FILE)
+SHOWN, HIDDEN_PX = KB_H, 1            # 1, not 0: fbterm keeps scrolling by redraw
 KEY_VOLUMEDOWN = 114
 
+def reserved():
+    try:
+        with open(RESERVE) as f:
+            return int(f.read())
+    except (OSError, ValueError):
+        return SHOWN
+
 def hardware_keyboard():
     """True if a USB keyboard (with letter keys) is plugged in."""
     for dev in glob.glob("/sys/class/input/event*/device"):
@@ -170,11 +178,11 @@ def hardware_keyboard():
 
 class Visibility:
     """Hide the keyboard while a USB keyboard is attached; Volume Down toggles.
-    Changing it restarts fbterm (inittab respawns s10-term, tmux reattaches)."""
+    fbterm resizes in place on SIGWINCH after reading RESERVE."""
     def __init__(self, kb):
         self.kb, self.manual, self.next_scan = kb, None, 0
         self.usb = hardware_keyboard()
-        self.visible = not os.path.exists(HIDDEN)      # what the running terminal uses
+        self.visible = reserved() != HIDDEN_PX          # what the running terminal uses
         self.keys_fd = None
         for dev in glob.glob("/sys/class/input/event*"):
             try:
@@ -182,9 +190,10 @@ class Visibility:
                     self.keys_fd = os.open("/dev/input/" + os.path.basename(dev), os.O_RDONLY)
             except OSError:
                 pass
-        self.apply(not self.usb, restart_terminal=False)
-        if not self.visible:
-            self.kb.fb[TOP * LL:(TOP + KB_H) * LL] = bytes(KB_H * LL)
+        if self.visible == self.usb:
+            self.apply(not self.usb)
+        elif not self.visible:
+            self.kb.fb[TOP * LL:(TOP + KB_H) * LL] = bytes(KB_H * LL)   # Keyboard() drew it
 
     def poll(self, now):
         if now < self.next_scan:
@@ -203,20 +212,15 @@ class Visibility:
                 self.manual = not self.visible
                 self.apply(self.manual)
 
-    def apply(self, visible, restart_terminal=True):
-        if visible == self.visible and not restart_terminal:
-            return
-        changed = visible != self.visible
+    def apply(self, visible):
         self.visible = visible
-        if visible:
-            if os.path.exists(HIDDEN): os.remove(HIDDEN)
-        else:
-            open(HIDDEN, "w").close()
+        with open(RESERVE, "w") as f:
+            f.write(str(SHOWN if visible else HIDDEN_PX))
+        if not visible:
             self.kb.fb[TOP * LL:(TOP + KB_H) * LL] = bytes(KB_H * LL)   # clear the strip
-        if changed or restart_terminal:
-            subprocess.run(["pkill", "-x", "fbterm"])     # inittab restarts s10-term
+        subprocess.run(["pkill", "-WINCH", "-x", "fbterm"])  # fbterm re-reads RESERVE
         if visible:
-            time.sleep(1.2)                                # let fbterm come back, then draw
+            time.sleep(0.05)                               # let fbterm stop drawing there
             self.kb.draw()
 
 def screen_waking(now):
diff --git a/device/downstream/s10-terminal/s10-term b/device/downstream/s10-terminal/s10-term
index c89ce1fa63..c3e0009ce7 100644
--- a/device/downstream/s10-terminal/s10-term
+++ b/device/downstream/s10-terminal/s10-term
@@ -1,12 +1,9 @@
 #!/bin/sh
 # Terminal session for tty1: fbterm + tmux above the on-screen keyboard.
+# s10-osk writes the keyboard height (1 while hidden) to the reserve file and
+# sends fbterm SIGWINCH, so fbterm resizes without restarting.
 [ -f "$HOME/.fbtermrc" ] || cp /usr/share/s10-terminal/fbtermrc "$HOME/.fbtermrc"
 export TERM=fbterm
-if [ -e /run/s10-osk-hidden ]; then
-	# keyboard hidden (USB keyboard or Volume Down): use the full height.
-	# 1 px instead of 0 keeps fbterm scrolling by redraw, never by panning.
-	export FBTERM_RESERVE_BOTTOM=1
-else
-	export FBTERM_RESERVE_BOTTOM=1100   # height of s10-osk
-fi
+export FBTERM_RESERVE_FILE=/run/s10-osk-reserve
+export FBTERM_RESERVE_BOTTOM="$(cat "$FBTERM_RESERVE_FILE" 2>/dev/null || echo 1100)"
 exec fbterm -- tmux new -A -s main
