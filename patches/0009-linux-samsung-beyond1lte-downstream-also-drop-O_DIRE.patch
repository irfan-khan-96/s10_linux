From 842c93158b766efb465858db0a88c93653b26769 Mon Sep 17 00:00:00 2001
From: khan <khan@localhost>
Date: Sat, 31 Oct 2026 12:23:58 +0100
Subject: [PATCH 09/47] linux-samsung-beyond1lte-downstream: also drop O_DIRECT
 when loop refuses direct I/O

---
 .../APKBUILD                                  |  4 +--
 .../loop-dio-blockdev-bsize.patch             | 32 +++++++++++++++----
 2 files changed, 28 insertions(+), 8 deletions(-)

diff --git a/device/downstream/linux-samsung-beyond1lte-downstream/APKBUILD b/device/downstream/linux-samsung-beyond1lte-downstream/APKBUILD
index e15bb052f3..9156efcd4e 100644
--- a/device/downstream/linux-samsung-beyond1lte-downstream/APKBUILD
+++ b/device/downstream/linux-samsung-beyond1lte-downstream/APKBUILD
@@ -5,7 +5,7 @@
 maintainer="chiffa <chiffathefoxx@gmail.com>"
 pkgname=linux-samsung-beyond1lte-downstream
 pkgver=4.14.316
-pkgrel=2
+pkgrel=3
 pkgdesc="Samsung Galaxy S10 downstream kernel fork"
 arch="aarch64"
 _carch="arm64"
@@ -65,5 +65,5 @@ a4a99dd42d0f687e5f0a46fc0f7dd61ffa5deb06459153befe109bed87cb282ab3d1454836865b78
 1872a4d9963f128965ab46b329d448e6b776d373cf99f2b8e11d025aa3e10a0308da19beb715c6bdced0b2c6ef44c47a5c013554a19787a64f8ac58d34bc912f  remove-header-lkc.patch
 182be3c596b9cc267ac108d7cf03fc8c328ccc6b36770800e4dcedea8d1bb65e3f5eacf590c2948f58b1418cc60a1670ba77dde8c259e428d158c31b6e1dbaf5  fix-check-lxdialog.patch
 6ab9db01d35f7f5cc2c19ebe5f65a7dc479a1c68de587300cdde9a6c759d34610666c72f0f321cd450cf56c13df3b54a774e0f7ebdbf0f8608fbfd66b49d04e7  selinux_include_generated_headers.patch
-3b7a2c7b5821a122a386138f37211d23fb536db67555bc5268c836c3016ca0c742251dbd70cb3b906770709118b8f2619ac0565489a91ee0615e81a08d6b8ab0  loop-dio-blockdev-bsize.patch
+bda3c962bd63f16260f217b8b5978c14de60b80ea9113e7bbb7f1d3c0a867fa17af0230d9b87be21e3bf5e9c944ba930e5f0226779bd2e5c65078653726452bb  loop-dio-blockdev-bsize.patch
 "
diff --git a/device/downstream/linux-samsung-beyond1lte-downstream/loop-dio-blockdev-bsize.patch b/device/downstream/linux-samsung-beyond1lte-downstream/loop-dio-blockdev-bsize.patch
index b250087520..a7427459d7 100644
--- a/device/downstream/linux-samsung-beyond1lte-downstream/loop-dio-blockdev-bsize.patch
+++ b/device/downstream/linux-samsung-beyond1lte-downstream/loop-dio-blockdev-bsize.patch
@@ -1,11 +1,12 @@
-loop: use backing block device's logical block size for direct I/O
+loop: don't use direct I/O that the backing block device can't do
 
-Without this, direct I/O is enabled for a 512-byte loop device on top of
-4K-sector UFS, and postmarketOS's 'losetup --direct-io=on' subpartitions
-cannot be mounted ('unable to read superblock').
+Use the backing block device's logical block size when deciding on
+direct I/O, and drop O_DIRECT from the backing file when it is refused.
+Without this, postmarketOS's 'losetup --direct-io=on' subpartitions on
+4K-sector UFS cannot be mounted ('unable to read superblock').
 
---- a/drivers/block/loop.c	2026-10-31 12:04:06.597914761 +0100
-+++ b/drivers/block/loop.c	2026-10-31 12:04:06.645160261 +0100
+--- a/drivers/block/loop.c	2026-10-31 12:23:57.697164181 +0100
++++ b/drivers/block/loop.c	2026-10-31 12:23:57.767223982 +0100
 @@ -177,6 +177,16 @@
  		sb_bsize = bdev_logical_block_size(inode->i_sb->s_bdev);
  		dio_align = sb_bsize - 1;
@@ -23,3 +24,22 @@ cannot be mounted ('unable to read superblock').
  
  	/*
  	 * We support direct I/O only if lo_offset is aligned with the
+@@ -200,6 +210,18 @@
+ 		use_dio = false;
+ 	}
+ 
++	/*
++	 * losetup --direct-io opens the backing file with O_DIRECT. If direct
++	 * I/O was refused above, buffered lo_read_simple()/lo_write_simple()
++	 * would still go through that O_DIRECT file with unaligned sizes, so
++	 * drop the flag to really fall back to the page cache.
++	 */
++	if (!use_dio && (file->f_flags & O_DIRECT)) {
++		spin_lock(&file->f_lock);
++		file->f_flags &= ~O_DIRECT;
++		spin_unlock(&file->f_lock);
++	}
++
+ 	if (lo->use_dio == use_dio)
+ 		return;
+ 
