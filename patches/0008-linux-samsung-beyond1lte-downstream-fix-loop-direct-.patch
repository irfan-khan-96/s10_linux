--- /dev/null
+++ b/device/downstream/linux-samsung-beyond1lte-downstream/loop-dio-blockdev-bsize.patch
@@ -0,0 +1,25 @@
+loop: use backing block device's logical block size for direct I/O
+
+Without this, direct I/O is enabled for a 512-byte loop device on top of
+4K-sector UFS, and postmarketOS's 'losetup --direct-io=on' subpartitions
+cannot be mounted ('unable to read superblock').
+
+--- a/drivers/block/loop.c	2026-10-31 12:04:06.597914761 +0100
++++ b/drivers/block/loop.c	2026-10-31 12:04:06.645160261 +0100
+@@ -177,6 +177,16 @@
+ 		sb_bsize = bdev_logical_block_size(inode->i_sb->s_bdev);
+ 		dio_align = sb_bsize - 1;
+ 	}
++	/*
++	 * A block device backing file sits on the bdev pseudo filesystem, which
++	 * has no s_bdev, so use the device's own logical block size. Otherwise
++	 * direct I/O gets enabled on 4K-sector UFS behind a 512-byte loop device
++	 * and every unaligned read (e.g. ext4 superblock probing) fails.
++	 */
++	if (S_ISBLK(inode->i_mode)) {
++		sb_bsize = bdev_logical_block_size(I_BDEV(inode));
++		dio_align = sb_bsize - 1;
++	}
+ 
