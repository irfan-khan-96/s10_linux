+++ b/device/downstream/device-samsung-beyond1lte-downstream/deviceinfo
@@ -33,3 +33,5 @@ deviceinfo_no_framebuffer="true"
 deviceinfo_rootfs_image_sector_size="4096"
 deviceinfo_bootimg_append_seandroidenforce="true"
 deviceinfo_create_initfs_extra="true"
+# 4.14 downstream kernel has no zstd initramfs support (only gzip/lz4)
+deviceinfo_initfs_compression="gzip"
