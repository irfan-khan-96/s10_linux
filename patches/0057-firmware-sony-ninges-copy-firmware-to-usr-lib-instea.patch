From e2874e0d5132cddd7f819ebaf5de23b4412a689b Mon Sep 17 00:00:00 2001
From: Aster Boese <asterboese@mailbox.org>
Date: Tue, 3 Nov 2026 16:13:03 -0500
Subject: [PATCH 057/107] firmware-sony-ninges: copy firmware to `/usr/lib/`
 instead of `/lib/`

`/lib/` is a symlink to `/usr/lib/`, so the correct location to copy to
is `/usr/lib/` directly.

This package misbehaves by modifying under `/usr/` programmatically, but
that can be fixed later. For now, completing the usr-merge is more
important.

Signed-off-by: Aster Boese <asterboese@mailbox.org>
Part-of: <https://gitlab.nura.eco/nura/pmaports/-/merge_requests/9874>
---
 device/testing/firmware-sony-ninges/APKBUILD            | 6 +++---
 device/testing/firmware-sony-ninges/copy-firmware.initd | 8 ++++----
 2 files changed, 7 insertions(+), 7 deletions(-)

diff --git a/device/testing/firmware-sony-ninges/APKBUILD b/device/testing/firmware-sony-ninges/APKBUILD
index e0edbd3b88..a900ce8761 100644
--- a/device/testing/firmware-sony-ninges/APKBUILD
+++ b/device/testing/firmware-sony-ninges/APKBUILD
@@ -1,7 +1,7 @@
 maintainer="Alexey Minnekhanov <alexeymin@minlexx.ru>"
 pkgname=firmware-sony-ninges
-pkgver=2
-pkgrel=1
+pkgver=3
+pkgrel=0
 pkgdesc="Firmware for Sony Xperia XA2/Plus/Ultra & 10/10 Plus"
 url="postmarketos.org"
 arch="aarch64"
@@ -27,5 +27,5 @@ openrc() {
 }
 
 sha512sums="
-53a6f039264547a2f5972c45a9b4c468867a0dc2f2eaea0f085d323643a8cd2f308fa840cd30502c0511441754ca1ee2f7a242135e37e73b9123a5e4162e2da6  copy-firmware.initd
+dab4e087bc5557ef0a420dd3171733f5bc3cb829d3a2cb46142c24071dae7721eb8777cf1fab17f1bffcc30bd364d5b614c60499283d27766f1a257782559fcc  copy-firmware.initd
 "
diff --git a/device/testing/firmware-sony-ninges/copy-firmware.initd b/device/testing/firmware-sony-ninges/copy-firmware.initd
index 35bd1790cf..00c7818f53 100644
--- a/device/testing/firmware-sony-ninges/copy-firmware.initd
+++ b/device/testing/firmware-sony-ninges/copy-firmware.initd
@@ -6,14 +6,14 @@ start() {
 	# Set up directories (if needed)
 	mkdir -p /opt/firmware/modem
 	mkdir -p /opt/firmware/odm
-	mkdir -p /lib/firmware/qcom/venus-4.4
+	mkdir -p /usr/lib/firmware/qcom/venus-4.4
 
 	# Copy all the firmware over (except Venus)
-	rsync -r -l -p --owner=root --group=root --chmod=0755 --exclude 'venus*' /opt/firmware/modem/image/* /lib/firmware/
+	rsync -r -l -p --owner=root --group=root --chmod=0755 --exclude 'venus*' /opt/firmware/modem/image/* /usr/lib/firmware/
 
 	# Copy Venus FW over to the correct location
-	rsync -r -l -p --owner=root --group=root --chmod=0755 /opt/firmware/modem/image/venus* /lib/firmware/qcom/venus-4.4
+	rsync -r -l -p --owner=root --group=root --chmod=0755 /opt/firmware/modem/image/venus* /usr/lib/firmware/qcom/venus-4.4
 
 	# Get Adreno & ZAP firmware from ODM package
-	rsync -r -l -p --owner=root --group=root --chmod=0755 /opt/firmware/odm/firmware/* /lib/firmware/qcom
+	rsync -r -l -p --owner=root --group=root --chmod=0755 /opt/firmware/odm/firmware/* /usr/lib/firmware/qcom
 } 
