From b1bc0428ea90e2d22e3b293c4ebd58fb38c934a6 Mon Sep 17 00:00:00 2001
From: Aster Boese <asterboese@mailbox.org>
Date: Tue, 3 Nov 2026 20:01:00 -0500
Subject: [PATCH 035/107] firmware-nothing-spacewar: install to /usr/lib/

/lib/ has been a symlink to /usr/lib/ for quite a while now.
Thus, this change only moves the files in packaging, but on
devices, /usr/lib/ has been the sole path in use.

Signed-off-by: Aster Boese <asterboese@mailbox.org>
Part-of: <https://gitlab.nura.eco/nura/pmaports/-/merge_requests/9877>
---
 device/testing/firmware-nothing-spacewar/APKBUILD | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/device/testing/firmware-nothing-spacewar/APKBUILD b/device/testing/firmware-nothing-spacewar/APKBUILD
index 7e6792afad..4930e82702 100644
--- a/device/testing/firmware-nothing-spacewar/APKBUILD
+++ b/device/testing/firmware-nothing-spacewar/APKBUILD
@@ -2,8 +2,8 @@
 # Co-Maintainer: Vasiliy Doylov <neko@altlinux.org>
 maintainer="Danila Tikhonov <danila@mainlining.org>"
 pkgname=firmware-nothing-spacewar
-pkgver=3
-pkgrel=1
+pkgver=4
+pkgrel=0
 pkgdesc="Firmware for Nothing Phone (1)"
 url="https://github.com/mainlining/firmware-nothing-spacewar"
 arch="aarch64"
@@ -17,6 +17,7 @@ package() {
 	mkdir -p "$pkgdir"
 
 	find . -type f -exec install -Dm644 {} "$pkgdir"/{} \;
+	mv "$pkgdir"/lib "$pkgdir"/usr
 }
 
 sha512sums="
-- 
2.53.0

