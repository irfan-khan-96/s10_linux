From c798775177c6b289696025cd383519efb07cedb3 Mon Sep 17 00:00:00 2001
From: khan <khan@localhost>
Date: Sun, 1 Nov 2026 23:32:02 +0100
Subject: [PATCH 26/28] s10-terminal: turn off Syncthing crash reporting

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 device/downstream/s10-terminal/APKBUILD            |  4 ++--
 device/downstream/s10-terminal/s10-syncthing-setup | 10 ++++++++--
 device/downstream/s10-terminal/s10-syncthing.initd |  2 +-
 3 files changed, 11 insertions(+), 5 deletions(-)

diff --git a/device/downstream/s10-terminal/APKBUILD b/device/downstream/s10-terminal/APKBUILD
index 7e15314932..569fd70388 100644
--- a/device/downstream/s10-terminal/APKBUILD
+++ b/device/downstream/s10-terminal/APKBUILD
@@ -72,8 +72,8 @@ package() {
 sha512sums="
 43fbf0749d3c12ee3e6506847cd4de04868d6cfad5d49da96fad5cbbd686c816eb762df10115c0826fe2887a63685a9c3a4ae30ae8056e4cce7b6e9b5254dc1a  s10-osk
 2a4052a8d61561ce6b0560d6f091d4f9a3cb4f5d9afe174e95f6cece873f5cfdd750a8d475af3a5b7953ac64150316aa2c04853f533cf8b18b4c8205f7c05b81  s10-menu
-a5dc429c0847094b79f30a20a85284284c055a3b4c817b90e1c89693bbdc790a246039582702d0f505779e26ae51247b58a9dda80cf7c73b04f6ef5e9813709d  s10-syncthing-setup
-f72d07d0a20dc082e662776ae928096cffd7f5b88f7ec004800e73e6ee9a0688b788fc2014e80be1366f364b598d4e6925eee57a09fa1494b9b739310e22761b  s10-syncthing.initd
+34cf41d63afb4fea75590d655b57665f8e3213d9ac0d32a13b4331b2445c58ebb8cd772c7d53b3ae2dfdbdb55ee53b648e1e3aa472f07202f03d6f2960db9620  s10-syncthing-setup
+c6ff79c57ab2ddb511011e0c30cc383e79b34b65ecc26b8a4651907d92d2b2ef52c2942d926cad8a81db596edcb950b71afbc5295e8b9fea07417ab69c17f527  s10-syncthing.initd
 d3f73cfc060ad3222521699ba980d4ade218bf2ee8b9681bd6abebd8300602bca3283eb0cabce74792355741d8812f2f1753e16b540b229812a4c404a95cec0a  s10-idle-blank
 f5b670528587d518a367b66ae15fd9b5583b7ad666e03051523cf56a1b007469fc5fad535f4d22b12106042e93352b07594ec6dbc4da50766b3757d6e103f12b  s10-touch-absfix
 9daf9ac5a89cd6d83560f26e35b95253ea71b20eeb3556ebdf31e2b7e4a66dfa4845c0f73c43601ac63f2e56613f17777691135d564f4924f23b9a3865838e6f  s10-osk-start
diff --git a/device/downstream/s10-terminal/s10-syncthing-setup b/device/downstream/s10-terminal/s10-syncthing-setup
index 1dc66952a8..a72cc22077 100644
--- a/device/downstream/s10-terminal/s10-syncthing-setup
+++ b/device/downstream/s10-terminal/s10-syncthing-setup
@@ -8,7 +8,13 @@ st config options global-ann-enabled set false
 st config options relays-enabled set false
 st config options natenabled set false
 st config options uraccepted set -- -1
-st config options crash-reporting-enabled set false
 st config options auto-upgrade-intervalh set 0
-st config defaults folder path set "$HOME"
+# crash reporting has no cli option; use the local REST API
+python3 - "$(st config gui apikey get)" <<'EOF'
+import sys, urllib.request
+req = urllib.request.Request("http://127.0.0.1:8384/rest/config/options", method="PATCH",
+    data=b'{"crashReportingEnabled": false}',
+    headers={"X-API-Key": sys.argv[1], "Content-Type": "application/json"})
+urllib.request.urlopen(req)
+EOF
 echo "Device ID: $(st show system | sed -n 's/.*"myID": "\(.*\)".*/\1/p')"
diff --git a/device/downstream/s10-terminal/s10-syncthing.initd b/device/downstream/s10-terminal/s10-syncthing.initd
index a0e2b85e22..26c7b8f657 100644
--- a/device/downstream/s10-terminal/s10-syncthing.initd
+++ b/device/downstream/s10-terminal/s10-syncthing.initd
@@ -7,7 +7,7 @@ supervisor=supervise-daemon
 command=/usr/bin/syncthing
 command_args="serve --no-browser --home=/home/$user/.config/syncthing --gui-address=127.0.0.1:8384"
 command_user="$user:$user"
-supervise_daemon_args="--env HOME=/home/$user"
+supervise_daemon_args="--env HOME=/home/$user --env STNODEFAULTFOLDER=1"
 
 depend() {
 	need net
-- 
