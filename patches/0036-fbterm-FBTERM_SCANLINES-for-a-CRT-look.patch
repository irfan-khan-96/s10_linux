From 2075c883fe456b647e72753302c031c11f1bcd8d Mon Sep 17 00:00:00 2001
From: khan <khan@localhost>
Date: Mon, 2 Nov 2026 01:46:38 +0100
Subject: [PATCH 36/52] fbterm: FBTERM_SCANLINES for a CRT look

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 main/fbterm/APKBUILD        |  4 ++-
 main/fbterm/scanlines.patch | 69 +++++++++++++++++++++++++++++++++++++
 2 files changed, 72 insertions(+), 1 deletion(-)
 create mode 100644 main/fbterm/scanlines.patch

diff --git a/main/fbterm/APKBUILD b/main/fbterm/APKBUILD
index a660834ae2..4de7c78d98 100644
--- a/main/fbterm/APKBUILD
+++ b/main/fbterm/APKBUILD
@@ -1,7 +1,7 @@
 # Local package for the S10 fork: fbterm with Debian's patches
 pkgname=fbterm
 pkgver=1.7
-pkgrel=3
+pkgrel=4
 _debrel=5
 pkgdesc="Fast framebuffer terminal emulator with TrueType fonts"
 url="https://salsa.debian.org/debian/fbterm"
@@ -16,6 +16,7 @@ source="https://deb.debian.org/debian/pool/main/f/fbterm/fbterm_$pkgver.orig.tar
 	reserve-bottom.patch
 	live-resize.patch
 	palette-refresh.patch
+	scanlines.patch
 	"
 builddir="$srcdir/fbterm-$pkgver"
 
@@ -49,4 +50,5 @@ a9f23806626bd2accf4b50e759f9cd6b4076353938c74ba6d1f461465754cebd47b7923e7c183ece
 766fa8a23d416f3f79da8ce947e89ed2ae17c823b618ae90f47231046f156053bc905ce2724247d3223ab03c96ec7aa12a83c54a4d3866d441336dab1622ad98  reserve-bottom.patch
 d7fbfa9f42972bd03aba3e51b8b2c6cdc7c46d4597f1972cf05bdfe1a2a4b9e4645eb07bb3a53f4122929a08f0bbf7db6d2ddfe079b564c3d211c90356f6427e  live-resize.patch
 9716a762d62c9b37e6eb5e32449fb83f3f612a6d169133c048850d2e92c209eaf416e295a49619abf32edabacf4acbf1efa07ba3ca292539a068098f3355b9bf  palette-refresh.patch
+e9c3933f38614124d26696929deec42848291172077cceb0ae09dd651f49dacb906630acf34c524fc7f14373a857d50ff9b5e47d19a3b71d1b51545e3d2c65b5  scanlines.patch
 "
diff --git a/main/fbterm/scanlines.patch b/main/fbterm/scanlines.patch
new file mode 100644
index 0000000000..e538b74e0a
--- /dev/null
+++ b/main/fbterm/scanlines.patch
@@ -0,0 +1,69 @@
+diff --git a/src/screen_render.cpp b/src/screen_render.cpp
+index 53b9297..93f98bc 100644
+--- a/src/screen_render.cpp
++++ b/src/screen_render.cpp
+@@ -30,6 +30,10 @@
+ static u32 bytes_per_pixel;
+ static u32 ppl, ppw, ppb;
+ static u32 fillColors[NR_COLORS];
++static u32 scanPeriod, darkMask;    /* FBTERM_SCANLINES: darken every Nth row */
++static bool scanByColumn;           /* rotated 90/270: text rows are screen columns */
++#define DARK(c) (((c) >> 1) & darkMask)
++#define SCAN(n) (scanPeriod && (n) % scanPeriod == scanPeriod - 1)
+ 
+ static u8 *bgimage_mem;
+ static u8 bgcolor;
+@@ -71,6 +75,13 @@ void Screen::initFillDraw()
+ 	ppw = ppl >> 1;
+ 	ppb = ppl >> 2;
+ 
++	const char *scan = getenv("FBTERM_SCANLINES");
++	scanPeriod = scan ? strtoul(scan, 0, 10) : 0;
++	darkMask = mBitsPerPixel == 16 ? 0x7bef7bef : mBitsPerPixel == 15 ? 0x3def3def : mBitsPerPixel == 32 ? 0x7f7f7f : 0;
++	if (!darkMask || scanPeriod < 2) scanPeriod = 0;
++	scanByColumn = (mRotateType == Rotate90 || mRotateType == Rotate270);
++	if (scanByColumn && mBitsPerPixel != 16) scanPeriod = 0;
++
+ 	bool bg = false;
+ 	if (getenv("FBTERM_BACKGROUND_IMAGE")) {
+ 		bg = true;
+@@ -114,6 +125,12 @@ void Screen::fillX(u32 x, u32 y, u32 w, u8 color)
+ 	u32 c = fillColors[color];
+ 	u8 *dst = mVMemBase + y * mBytesPerLine + x * bytes_per_pixel;
+ 
++	if (scanPeriod && scanByColumn) {	/* 16 bpp only: per pixel, darker on scan columns */
++		for (u32 i = 0; i < w; i++, dst += 2) writew(dst, SCAN(x + i) ? DARK(c) : c);
++		return;
++	}
++	if (!scanByColumn && SCAN(y)) c = DARK(c);
++
+ 	// get better performance if write-combining not enabled for video memory
+ 	for (u32 i = w / ppl; i--; dst += 4) {
+ 		writel(dst, c);
+@@ -176,20 +193,22 @@ void Screen::draw##bits(u32 x, u32 y, u32 w, u8 fc, u8 bc, u8 *pixmap) \
+ 	u8 pixel; \
+ 	type color; \
+ 	type *dst = (type *)(mVMemBase + y * mBytesPerLine + x * bytes_per_pixel); \
++	bool rowDark = !scanByColumn && SCAN(y); \
+  \
+-	for (; w--; pixmap++, dst++) { \
++	for (u32 cx = x; w--; pixmap++, dst++, cx++) { \
+ 		pixel = *pixmap; \
++		bool dark = rowDark || (scanByColumn && SCAN(cx)); \
+  \
+-		if (!pixel) fbwrite(dst, fillColors[bc]); \
+-		else if (pixel == 0xff) fbwrite(dst, fillColors[fc]); \
++		if (!pixel) color = fillColors[bc]; \
++		else if (pixel == 0xff) color = fillColors[fc]; \
+ 		else { \
+ 			red = mPalette[bc].red + (((mPalette[fc].red - mPalette[bc].red) * pixel) >> 8); \
+ 			green = mPalette[bc].green + (((mPalette[fc].green - mPalette[bc].green) * pixel) >> 8); \
+ 			blue = mPalette[bc].blue + (((mPalette[fc].blue - mPalette[bc].blue) * pixel) >> 8); \
+  \
+ 			color = ((red >> (8 - lred) << (lgreen + lblue)) | (green >> (8 - lgreen) << lblue) | (blue >> (8 - lblue))); \
+-			fbwrite(dst, color); \
+ 		} \
++		fbwrite(dst, dark ? (type)DARK(color) : color); \
+ 	} \
+ }
+ 
