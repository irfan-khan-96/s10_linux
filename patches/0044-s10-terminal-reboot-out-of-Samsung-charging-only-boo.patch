From 6ffa934c12b4ed98a2834d4564cf586c244f0235 Mon Sep 17 00:00:00 2001
From: khan <khan@localhost>
Date: Fri, 6 Nov 2026 23:47:24 +0100
Subject: [PATCH 44/47] s10-terminal: reboot out of Samsung charging-only boot
 (no touch); keyboard waits for the touchscreen

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 device/downstream/s10-terminal/05-s10-lpm.start | 17 +++++++++++++++++
 device/downstream/s10-terminal/APKBUILD         |  8 +++++---
 device/downstream/s10-terminal/s10-osk          | 10 +++++++++-
 3 files changed, 31 insertions(+), 4 deletions(-)
 create mode 100644 device/downstream/s10-terminal/05-s10-lpm.start

diff --git a/device/downstream/s10-terminal/05-s10-lpm.start b/device/downstream/s10-terminal/05-s10-lpm.start
new file mode 100644
index 0000000000..4144371479
--- /dev/null
+++ b/device/downstream/s10-terminal/05-s10-lpm.start
@@ -0,0 +1,17 @@
+#!/bin/sh
+# Plugging the charger into a switched-off S10 makes the bootloader start the kernel in
+# Samsung's charging-only mode (androidboot.mode=charger): the kernel then sets lpcharge
+# and the touchscreen, hall and similar drivers refuse to load. Reboot into a normal boot.
+# Guard: at most one such reboot per 10 minutes, so a bootloader that insists cannot loop.
+grep -q 'androidboot.mode=charger' /proc/cmdline || exit 0
+stamp=/var/lib/s10-terminal/lpm-reboot
+mkdir -p /var/lib/s10-terminal
+now=$(date +%s)
+last=$(cat "$stamp" 2>/dev/null || echo 0)
+if [ $((now - last)) -lt 600 ]; then
+	echo "s10: charging-only boot again within 10 min, staying up without touch" > /dev/kmsg
+	exit 0
+fi
+echo "$now" > "$stamp"
+echo "s10: charging-only boot (no touchscreen), rebooting normally" > /dev/kmsg
+reboot
