From 04c0a43399724915649d6aae9e2cc26826760a6c Mon Sep 17 00:00:00 2001
From: Aster Boese <asterboese@mailbox.org>
Date: Sun, 11 Oct 2026 12:50:16 -0400
Subject: [PATCH 028/107] main/postmarketos-base-ui: move elogind logind.conf
 to usr/lib

elogind's documentation falsely stated that it did not support paths under /usr/lib/
for configuration. After discussion with the elogind maintainer, it seems that it
actually does and the documentation was just worded badly. Thus, let's move the config
to match how we package systemd.

Signed-off-by: Aster Boese <asterboese@mailbox.org>
Part-of: <https://gitlab.nura.eco/nura/pmaports/-/merge_requests/9730>
---
 main/postmarketos-base-ui/APKBUILD                         | 7 +++----
 ...gind-logind.conf => rootfs-usr-lib-elogind-logind.conf} | 0
 2 files changed, 3 insertions(+), 4 deletions(-)
 rename main/postmarketos-base-ui/{rootfs-etc-elogind-logind.conf => rootfs-usr-lib-elogind-logind.conf} (100%)

diff --git a/main/postmarketos-base-ui/APKBUILD b/main/postmarketos-base-ui/APKBUILD
index 0558afe4d0..9caf58716b 100644
--- a/main/postmarketos-base-ui/APKBUILD
+++ b/main/postmarketos-base-ui/APKBUILD
@@ -85,7 +85,6 @@ _pmb_recommends="
 _source644="
 	etc/chrony/chrony.conf
 	etc/environment
-	etc/elogind/logind.conf
 	etc/conf.d/bluetooth
 	etc/conf.d/openrc-settingsd
 	etc/conf.d/modemmanager
@@ -97,6 +96,7 @@ _source644="
 	etc/pulse/default.pa.d/postmarketos.pa
 	etc/sleep-inhibitor.conf
 	etc/X11/Xwrapper.config
+	usr/lib/elogind/logind.conf
 	usr/lib/NetworkManager/conf.d/50-connectivity.conf
 	usr/lib/NetworkManager/conf.d/50-hostname-mode.conf
 	usr/lib/NetworkManager/conf.d/50-iwd.conf
@@ -189,10 +189,9 @@ openrc() {
 elogind() {
 	install_if="$pkgname=$pkgver-r$pkgrel elogind"
 	depends="!systemd-logind sleep-inhibitor-openrc openrc"
-	replaces="elogind"
 	provides="postmarketos-base-elogind=$pkgver-r$pkgrel"
 
-	amove etc/elogind/logind.conf
+	amove usr/lib/elogind/logind.conf
 }
 
