diff --git a/device/downstream/s10-terminal/s10-idle-blank b/device/downstream/s10-terminal/s10-idle-blank
new file mode 100755
index 0000000000..f1e3897935
--- /dev/null
+++ b/device/downstream/s10-terminal/s10-idle-blank
@@ -0,0 +1,48 @@
+#!/usr/bin/python3
+# Turn the S10 panel off after IDLE seconds without input, and back on at the
+# first key press, touch or button (USB keyboards may be plugged in at any time).
+import glob, os, select, time
+
+IDLE = int(os.environ.get("S10_IDLE_SECONDS", "120"))
+BLANK = "/sys/class/graphics/fb0/blank"
+
+STATE = "/run/s10-blanked"  # "1" while off, "0" just after waking (read by s10-osk)
+
+def set_blank(off):
+    with open(BLANK, "w") as f:
+        f.write("1" if off else "0")
+    with open(STATE, "w") as f:
+        f.write("1" if off else "0")
+
+def open_inputs(fds):
+    for path in glob.glob("/dev/input/event*"):
+        if path not in fds:
+            try:
+                fds[path] = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
+            except OSError:
+                pass
+
+fds, blanked, last = {}, False, time.monotonic()
+set_blank(False)
+while True:
+    open_inputs(fds)  # pick up hot-plugged keyboards
+    ready, _, _ = select.select(list(fds.values()), [], [], 5)
+    activity = False
+    for fd in ready:
+        try:
+            if os.read(fd, 4096):
+                activity = True
+        except OSError:  # device unplugged
+            for path, f in list(fds.items()):
+                if f == fd:
+                    os.close(f)
+                    del fds[path]
+    now = time.monotonic()
+    if activity:
+        last = now
+        if blanked:
+            set_blank(False)
+            blanked = False
+    elif not blanked and now - last >= IDLE:
+        set_blank(True)
+        blanked = True
diff --git a/device/downstream/s10-terminal/s10-osk b/device/downstream/s10-terminal/s10-osk
new file mode 100755
index 0000000000..2cf3506d25
--- /dev/null
+++ b/device/downstream/s10-terminal/s10-osk
@@ -0,0 +1,202 @@
+#!/usr/bin/python3
+# On-screen keyboard for the S10 terminal (fbterm). Draws into the bottom strip
+# of /dev/fb0 that fbterm leaves free (FBTERM_RESERVE_BOTTOM), reads the
+# touchscreen directly and types through a uinput virtual keyboard.
+# Drawing goes through mmap: Samsung's decon driver ignores write() on fb0.
+import fcntl, mmap, os, select, struct, time
+import numpy as np
+from PIL import Image, ImageDraw, ImageFont
+
+W, H_SCREEN = 1440, 3040
+KB_H = int(os.environ.get("S10_OSK_HEIGHT", "1100"))
+TOP = H_SCREEN - KB_H
+LL = W * 2                                  # RGB565, 2 bytes per pixel
+TOUCH = "/dev/input/s10-touchscreen"
+FONT = "/usr/share/fonts/jetbrains-mono/JetBrainsMono-Regular.ttf"
+VIBRATOR = "/sys/class/timed_output/vibrator/enable"
+BLANKED = "/run/s10-blanked"                # written by s10-idle-blank
+
+# Linux key codes (input-event-codes.h)
+K = dict(ESC=1, BKSP=14, TAB=15, ENTER=28, CTRL=29, SHIFT=42, ALT=56, SPACE=57,
+         UP=103, LEFT=105, RIGHT=106, DOWN=108, PGUP=104, PGDN=109)
+LETTERS = dict(zip("qwertyuiop", range(16, 26)), **dict(zip("asdfghjkl", range(30, 39))),
+               **dict(zip("zxcvbnm", range(44, 51))))
+DIGITS = dict(zip("1234567890", range(2, 12)))
+SYMBOLS = {"-": (12, 0), "_": (12, 1), "=": (13, 0), "+": (13, 1), "[": (26, 0), "{": (26, 1),
+           "]": (27, 0), "}": (27, 1), ";": (39, 0), ":": (39, 1), "'": (40, 0), '"': (40, 1),
+           "`": (41, 0), "~": (41, 1), "\\": (43, 0), "|": (43, 1), ",": (51, 0), "<": (51, 1),
+           ".": (52, 0), ">": (52, 1), "/": (53, 0), "?": (53, 1), " ": (57, 0)}
+SYMBOLS.update({s: (DIGITS[d], 1) for s, d in zip("!@#$%^&*()", "1234567890")})
+
+def char_key(c):
+    if c in LETTERS: return LETTERS[c], False
+    if c.lower() in LETTERS: return LETTERS[c.lower()], True
+    if c in DIGITS: return DIGITS[c], False
+    code, shift = SYMBOLS[c]; return code, bool(shift)
+
+# Layouts: list of rows; each key is (label, action, width). action: "c:<char>"
+# types a character, "k:<NAME>" a key, "m:<NAME>" toggles a modifier, "l:<layer>".
+def row(chars): return [(c, "c:" + c, 1) for c in chars]
+FN = [("Esc", "k:ESC", 1), ("Tab", "k:TAB", 1), ("Ctrl", "m:CTRL", 1.2), ("Alt", "m:ALT", 1),
+      ("←", "k:LEFT", 1), ("↓", "k:DOWN", 1), ("↑", "k:UP", 1), ("→", "k:RIGHT", 1)]
+LAYERS = {
+    "abc": [FN, row("1234567890"), row("qwertyuiop"), row("asdfghjkl"),
+            [("⇧", "m:SHIFT", 1.5)] + row("zxcvbnm") + [("⌫", "k:BKSP", 1.5)],
+            [("?123", "l:sym", 1.5), ("-", "c:-", 1), ("/", "c:/", 1), ("", "c: ", 4.5),
+             (".", "c:.", 1), ("⏎", "k:ENTER", 1.8)]],
+    "sym": [FN, row("!@#$%^&*()"), row("-_=+[]{};"), row(":'\"`~|\\<>"),
+            [("⇧", "m:SHIFT", 1.5)] + row(",.?/$&*") + [("⌫", "k:BKSP", 1.5)],
+            [("abc", "l:abc", 1.5), ("PgUp", "k:PGUP", 1.3), ("PgDn", "k:PGDN", 1.3), ("", "c: ", 3.4),
+             ("|", "c:|", 1), ("⏎", "k:ENTER", 1.8)]],
+}
+REPEATABLE = {"k:BKSP", "k:LEFT", "k:RIGHT", "k:UP", "k:DOWN", "c: "}
+
+BG, KEY, SPECIAL, TEXT, DOWN, ACTIVE = (0, 0, 0), (38, 38, 42), (58, 58, 64), (230, 230, 230), (70, 130, 220), (52, 100, 170)
+PAD = 10
+
+class Keyboard:
+    def __init__(self):
+        fd = os.open("/dev/fb0", os.O_RDWR)
+        self.fb = mmap.mmap(fd, LL * H_SCREEN, mmap.MAP_SHARED, mmap.PROT_READ | mmap.PROT_WRITE)
+        self.font = ImageFont.truetype(FONT, 58)
+        self.small = ImageFont.truetype(FONT, 42)
+        self.layer, self.mods, self.pressed = "abc", set(), None
+        self.uinput = self.make_uinput()
+        self.layout()
+        self.draw()
+
+    # ---- output: uinput virtual keyboard ----
+    def make_uinput(self):
+        fd = os.open("/dev/uinput", os.O_WRONLY | os.O_NONBLOCK)
+        fcntl.ioctl(fd, 0x40045564, 1)                       # UI_SET_EVBIT EV_KEY
+        for code in range(1, 120):
+            fcntl.ioctl(fd, 0x40045565, code)                # UI_SET_KEYBIT
+        dev = struct.pack("80sHHHHi", b"s10-osk", 0x06, 0x1234, 0x5678, 1, 0) + b"\0" * (4 * 64 * 4)
+        os.write(fd, dev)
+        fcntl.ioctl(fd, 0x5501)                              # UI_DEV_CREATE
+        time.sleep(0.3)
+        return fd
+
+    def emit(self, code, value):
+        os.write(self.uinput, struct.pack("qqHHi", 0, 0, 1, code, value))
+        os.write(self.uinput, struct.pack("qqHHi", 0, 0, 0, 0, 0))   # SYN_REPORT
+
+    def tap(self, code, shift=False):
+        held = [K[m] for m in ("CTRL", "ALT") if m in self.mods]
+        if shift or "SHIFT" in self.mods: held.append(K["SHIFT"])
+        for m in held: self.emit(m, 1)
+        self.emit(code, 1); self.emit(code, 0)
+        for m in reversed(held): self.emit(m, 0)
+
+    # ---- layout and drawing ----
+    def layout(self):
+        rows = LAYERS[self.layer]
+        rh = (KB_H - PAD) / len(rows)
+        self.keys = []
+        for r, keys in enumerate(rows):
+            units = sum(k[2] for k in keys)
+            uw = (W - PAD) / max(units, 10)
+            x = (W - units * uw) / 2 + PAD / 2
+            for label, action, width in keys:
+                box = (int(x + PAD / 2), int(r * rh + PAD), int(x + width * uw - PAD / 2), int((r + 1) * rh))
+                self.keys.append((box, label, action))
+                x += width * uw
+
+    def key_colour(self, action):
+        if self.pressed == action: return DOWN
+        if action.startswith("m:") and action[2:] in self.mods: return ACTIVE
+        return KEY if action.startswith("c:") and len(action) == 3 and action[2] != " " else SPECIAL
+
+    def label(self, label):
+        if "SHIFT" in self.mods and len(label) == 1 and label.isalpha(): return label.upper()
+        return label
+
+    def render(self, only=None):
+        img = Image.new("RGB", (W, KB_H), BG)
+        d = ImageDraw.Draw(img)
+        for box, label, action in self.keys:
+            d.rounded_rectangle(box, radius=18, fill=self.key_colour(action))
+            text = self.label(label)
+            font = self.font if len(text) <= 2 else self.small
+            cx, cy = (box[0] + box[2]) / 2, (box[1] + box[3]) / 2
+            d.text((cx, cy), text, font=font, fill=TEXT, anchor="mm")
+        return img
+
+    def draw(self):
+        rgb = np.asarray(self.render(), dtype=np.uint16)
+        rgb565 = ((rgb[..., 0] >> 3) << 11) | ((rgb[..., 1] >> 2) << 5) | (rgb[..., 2] >> 3)
+        self.fb[TOP * LL:(TOP + KB_H) * LL] = rgb565.astype("<u2").tobytes()
+
+    # ---- input ----
+    def key_at(self, x, y):
+        for box, label, action in self.keys:
+            if box[0] - PAD <= x <= box[2] + PAD and box[1] - PAD <= y <= box[3] + PAD:
+                return action
+        return None
+
+    def press(self, action):
+        kind, arg = action[0], action[2:]
+        if kind == "m":
+            self.mods ^= {arg}
+        elif kind == "l":
+            self.layer = arg; self.layout()
+        else:
+            if kind == "c":
+                code, shift = char_key(arg); self.tap(code, shift)
+            else:
+                self.tap(K[arg])
+            self.mods -= {"SHIFT", "CTRL", "ALT"}       # one-shot modifiers
+        try:
+            with open(VIBRATOR, "w") as f: f.write("12")
+        except OSError:
+            pass
+
+def screen_waking(now):
+    """True while the screen is off or was woken less than 0.7 s ago."""
+    try:
+        with open(BLANKED) as f:
+            if f.read().strip() == "1":
+                return True
+        return time.time() - os.path.getmtime(BLANKED) < 0.7
+    except OSError:
+        return False
+
+def main():
+    kb = Keyboard()
+    tfd = os.open(TOUCH, os.O_RDONLY)
+    x = y = None
+    down, down_since, last_repeat, slot = False, 0, 0, 0
+    tracking = {}
+    while True:
+        timeout = 0.03 if kb.pressed in REPEATABLE else None
+        r, _, _ = select.select([tfd], [], [], timeout)
+        now = time.monotonic()
+        if not r:
+            # key repeat for held Backspace / arrows / space
+            if kb.pressed and now - down_since > 0.45 and now - last_repeat > 0.06:
+                kb.press(kb.pressed); last_repeat = now
+            continue
+        data = os.read(tfd, 24 * 64)
+        for i in range(0, len(data), 24):
+            _, _, etype, code, value = struct.unpack("qqHHi", data[i:i + 24])
+            if etype == 3:                                  # EV_ABS
+                if code == 0x2f: slot = value
+                elif slot != 0: continue                    # single finger typing
+                elif code == 0x39:
+                    if value >= 0: tracking[0] = True; down = True
+                    else: tracking.pop(0, None); down = False
+                elif code == 0x35: x = value * W // 4096
+                elif code == 0x36: y = value * H_SCREEN // 4096
+            elif etype == 0 and code == 0:                  # SYN_REPORT
+                if down and kb.pressed is None and x is not None and y is not None and y >= TOP:
+                    if screen_waking(now):                   # this touch only wakes the screen
+                        continue
+                    action = kb.key_at(x, y - TOP)
+                    if action:
+                        kb.pressed, down_since, last_repeat = action, now, now
+                        kb.press(action); kb.draw()
+                elif not down and kb.pressed is not None:
+                    kb.pressed = None; kb.draw()
+
+if __name__ == "__main__":
+    main()
diff --git a/device/downstream/s10-terminal/s10-osk-start b/device/downstream/s10-terminal/s10-osk-start
new file mode 100644
index 0000000000..637959662c
--- /dev/null
+++ b/device/downstream/s10-terminal/s10-osk-start
@@ -0,0 +1,8 @@
+#!/bin/sh
+# (Re)start the idle screen-off daemon and the on-screen keyboard. Run as root.
+# Exact patterns, so this script never matches itself.
+pkill -f '^/usr/bin/python3 /usr/bin/s10-osk$'
+pkill -f '^/usr/bin/python3 /usr/bin/s10-idle-blank$'
+sleep 1
+setsid /usr/bin/s10-idle-blank >/dev/null 2>&1 < /dev/null &
+setsid /usr/bin/s10-osk > /tmp/osk.log 2>&1 < /dev/null &
