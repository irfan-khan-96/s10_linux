From 4c393c50d7c17bb0635b6f55967fc0508839957a Mon Sep 17 00:00:00 2001
From: khan <khan@localhost>
Date: Sun, 1 Nov 2026 18:43:36 +0100
Subject: [PATCH 14/34] fbterm: musl compatibility patch

---
 main/fbterm/APKBUILD          |  2 ++
 main/fbterm/musl-compat.patch | 37 +++++++++++++++++++++++++++++++++++
 2 files changed, 39 insertions(+)
 create mode 100644 main/fbterm/musl-compat.patch

diff --git a/main/fbterm/APKBUILD b/main/fbterm/APKBUILD
index 6a3150d0cb..a9743ad52c 100644
--- a/main/fbterm/APKBUILD
+++ b/main/fbterm/APKBUILD
@@ -11,6 +11,7 @@ makedepends="autoconf automake fontconfig-dev freetype-dev linux-headers ncurses
 options="!check"
 source="https://deb.debian.org/debian/pool/main/f/fbterm/fbterm_$pkgver.orig.tar.gz
 	https://deb.debian.org/debian/pool/main/f/fbterm/fbterm_$pkgver-$_debrel.debian.tar.xz
+	musl-compat.patch
 	"
 builddir="$srcdir/fbterm-$pkgver"
 
@@ -40,4 +41,5 @@ package() {
 sha512sums="
 3d3135bf289ca39824958c50cc36ee7dd4fce69e9cfb6ea3a657a72159794b73a1fcfd196b899fcc5d3644f57fa265c03edb4c18db175d739c3507482b8e8acc  fbterm_1.7.orig.tar.gz
 4a8d2f999d95e334c5e6ac081e538d414f6285656db622bd33572eec46e15d94192bbf336c48d2172007f5b8e73b056f9571ae018d17d064523cf8e819623b2b  fbterm_1.7-5.debian.tar.xz
+a9f23806626bd2accf4b50e759f9cd6b4076353938c74ba6d1f461465754cebd47b7923e7c183ecea164fb8ae573a4f5e06c75be5222ec58176912b2e298c6fd  musl-compat.patch
 "
diff --git a/main/fbterm/musl-compat.patch b/main/fbterm/musl-compat.patch
new file mode 100644
index 0000000000..7766d21517
--- /dev/null
+++ b/main/fbterm/musl-compat.patch
@@ -0,0 +1,37 @@
+diff -ru a/src/fbterm.cpp b/src/fbterm.cpp
+--- a/src/fbterm.cpp	2026-11-01 18:43:35.806177390 +0100
++++ b/src/fbterm.cpp	2026-11-01 18:43:35.858427391 +0100
+@@ -27,6 +27,10 @@
+ #include <linux/vt.h>
+ #include <linux/kdev_t.h>
+ #include "config.h"
++
++#ifndef WAIT_ANY
++#define WAIT_ANY (-1) /* glibc-only alias */
++#endif
+ #include "fbterm.h"
+ #include "fbshell.h"
+ #include "fbshellman.h"
+@@ -38,8 +42,8 @@
+ #include "mouse.h"
+ 
+ #ifdef HAVE_SIGNALFD
+-// <sys/signalfd.h> offered by some systems has bug with g++
+-#include "signalfd.h"
++// musl: use the system header (the bundled copy needs glibc macros)
++#include <sys/signalfd.h>
+ 
+ static sigset_t oldSigmask;
+ 
+diff -ru a/src/improxy.cpp b/src/improxy.cpp
+--- a/src/improxy.cpp	2026-11-01 18:43:35.806675590 +0100
++++ b/src/improxy.cpp	2026-11-01 18:43:35.858703391 +0100
+@@ -24,6 +24,8 @@
+ #include <string.h>
+ #include <errno.h>
+ #include <sys/socket.h>
++#include <sys/select.h>
++#include <sys/time.h>
+ #include "improxy.h"
+ #include "immessage.h"
+ #include "fbconfig.h"
