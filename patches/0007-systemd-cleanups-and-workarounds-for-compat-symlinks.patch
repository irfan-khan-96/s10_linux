From 4d9c0734532bc4139b1844aa89194d24ce38fbad Mon Sep 17 00:00:00 2001
From: Yu Watanabe <watanabe.yu+github@gmail.com>
Date: Wed, 21 Oct 2026 07:49:20 +0900
Subject: [PATCH 007/107] systemd: cleanups and workarounds for compat symlinks

This moves the eudev compat symlink from /sbin/udevd to /usr/sbin/udevd
to support usr-merge.

On a usr-merge system, the symlinks /sbin/init and /bin/udevadm are not
necessary anymore. But due to an issue in apk-tools [1], these still
need to be kept.

The target of the symlink /bin/udevadm is changed to /usr/bin/udevadm,
consistent with /usr/lib/systemd/systemd-udevd which also points to /usr/bin/udevadm.

[1] https://gitlab.alpinelinux.org/alpine/apk-tools/-/merge_requests/425

Part-of: <https://gitlab.nura.eco/nura/pmaports/-/merge_requests/9779>
---
 extra-repos/systemd/systemd/APKBUILD | 28 ++++++++++++++--------------
 1 file changed, 14 insertions(+), 14 deletions(-)

diff --git a/extra-repos/systemd/systemd/APKBUILD b/extra-repos/systemd/systemd/APKBUILD
index a3b561e999..3d650b91b1 100644
--- a/extra-repos/systemd/systemd/APKBUILD
+++ b/extra-repos/systemd/systemd/APKBUILD
@@ -351,13 +351,15 @@ package() {
 	done
 
 	if [ "$_systemd_upstream" != 1 ]; then
-		# initramfs hardcodes /sbin/init
-		mkdir -p "$pkgdir"/sbin
-		ln -sf "../usr/lib/systemd/systemd" "$pkgdir"/sbin/init
-
 		# this stuff is packaged in Alpine aports under "systemd-boot"
 		rm -rf "$pkgdir"/usr/lib/systemd/boot
 	fi
+
+	# Workaround for an apk-tools bug:
+	# https://gitlab.alpinelinux.org/alpine/apk-tools/-/merge_requests/425
+	# Drop this once a fixed apk-tools is available.
+	mkdir -p "$pkgdir"/sbin
+	ln -sf ../usr/lib/systemd/systemd "$pkgdir"/sbin/init
 }
 
 udevd() {
@@ -381,16 +383,14 @@ udevd() {
 	amove usr/lib/udev
 
 	# Install symlinks to be more like eudev
-	if [ "$_systemd_upstream" = 1 ]; then
-		mkdir -p "$subpkgdir"/usr/sbin
-		ln -sf ../bin/udevadm "$subpkgdir"/usr/sbin/udevd
-	else
-		# FIXME: After usr merge, convert these into relative symlinks to support
-		# installing this package into an arbitrary directory
-		mkdir -p "$subpkgdir"/sbin "$subpkgdir"/bin
-		ln -sf /usr/lib/systemd/systemd-udevd "$subpkgdir"/sbin/udevd
-		ln -sf /usr/lib/systemd/systemd-udevd "$subpkgdir"/bin/udevadm
-	fi
+	mkdir -p "$subpkgdir"/usr/sbin
+	ln -sf ../bin/udevadm "$subpkgdir"/usr/sbin/udevd
+
+	# Workaround for an apk-tools bug:
+	# https://gitlab.alpinelinux.org/alpine/apk-tools/-/merge_requests/425
+	# Drop this once a fixed apk-tools is available.
+	mkdir -p "$subpkgdir"/bin
+	ln -sf ../usr/bin/udevadm "$subpkgdir"/bin/udevadm
 }
 
 udevd_bcomp() {
-- 
