From 4c891549af76f978cbf07c3023792521c9907056 Mon Sep 17 00:00:00 2001
From: khan <khan@localhost>
Date: Mon, 2 Nov 2026 00:14:57 +0100
Subject: [PATCH 29/45] s10-terminal: no gettys on tty2-6, so the console
 cannot switch away from fbterm

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 device/downstream/s10-terminal/APKBUILD                  | 2 +-
 device/downstream/s10-terminal/s10-terminal.post-install | 3 +++
 device/downstream/s10-terminal/s10-terminal.post-upgrade | 3 +++
 3 files changed, 7 insertions(+), 1 deletion(-)

diff --git a/device/downstream/s10-terminal/APKBUILD b/device/downstream/s10-terminal/APKBUILD
index 4acffe70f5..f65dd99b95 100644
--- a/device/downstream/s10-terminal/APKBUILD
+++ b/device/downstream/s10-terminal/APKBUILD
@@ -2,7 +2,7 @@
 # setup that turns samsung-beyond1lte-downstream into a pocket terminal.
 pkgname=s10-terminal
 pkgver=1
-pkgrel=6
+pkgrel=7
 pkgdesc="Galaxy S10 pocket terminal: fbterm + tmux, on-screen keyboard, hardening"
 url="https://postmarketos.org"
 arch="aarch64"
diff --git a/device/downstream/s10-terminal/s10-terminal.post-install b/device/downstream/s10-terminal/s10-terminal.post-install
index b1dbb1fb07..1cd07d73bd 100644
--- a/device/downstream/s10-terminal/s10-terminal.post-install
+++ b/device/downstream/s10-terminal/s10-terminal.post-install
@@ -9,6 +9,9 @@ if [ -n "$user" ]; then
 	for g in video input audio; do addgroup "$user" "$g" 2>/dev/null; done
 	[ -f /etc/inittab.orig ] || cp /etc/inittab /etc/inittab.orig
 	sed -i "s|^tty1::respawn:.*|tty1::respawn:/bin/su -l $user -c /usr/bin/s10-term|" /etc/inittab
+	# no logins on tty2-6: nothing displays them, and switching there leaves fbterm without input
+	sed -i "s|^tty[2-6]::|#&|" /etc/inittab
+	kill -HUP 1 2>/dev/null
 fi
 rc-update -q del s10-syncthing default 2>/dev/null
 exit 0
diff --git a/device/downstream/s10-terminal/s10-terminal.post-upgrade b/device/downstream/s10-terminal/s10-terminal.post-upgrade
index b1dbb1fb07..1cd07d73bd 100644
--- a/device/downstream/s10-terminal/s10-terminal.post-upgrade
+++ b/device/downstream/s10-terminal/s10-terminal.post-upgrade
@@ -9,6 +9,9 @@ if [ -n "$user" ]; then
 	for g in video input audio; do addgroup "$user" "$g" 2>/dev/null; done
 	[ -f /etc/inittab.orig ] || cp /etc/inittab /etc/inittab.orig
 	sed -i "s|^tty1::respawn:.*|tty1::respawn:/bin/su -l $user -c /usr/bin/s10-term|" /etc/inittab
+	# no logins on tty2-6: nothing displays them, and switching there leaves fbterm without input
+	sed -i "s|^tty[2-6]::|#&|" /etc/inittab
+	kill -HUP 1 2>/dev/null
 fi
 rc-update -q del s10-syncthing default 2>/dev/null
 exit 0
-- 
