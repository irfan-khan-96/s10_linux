From 7e855fcbe5788a1437e02b391ab116962d7b234b Mon Sep 17 00:00:00 2001
From: khan <khan@localhost>
Date: Sun, 1 Nov 2026 19:22:54 +0100
Subject: [PATCH 17/23] fbterm: FBTERM_RESERVE_BOTTOM for an on-screen keyboard

---
 main/fbterm/APKBUILD             |  4 +++-
 main/fbterm/reserve-bottom.patch | 27 +++++++++++++++++++++++++++
 2 files changed, 30 insertions(+), 1 deletion(-)
 create mode 100644 main/fbterm/reserve-bottom.patch

diff --git a/main/fbterm/APKBUILD b/main/fbterm/APKBUILD
index 65037b6129..6d490ded98 100644
--- a/main/fbterm/APKBUILD
+++ b/main/fbterm/APKBUILD
@@ -1,7 +1,7 @@
 # Local package for the S10 fork: fbterm with Debian's patches
 pkgname=fbterm
 pkgver=1.7
-pkgrel=0
+pkgrel=1
 _debrel=5
 pkgdesc="Fast framebuffer terminal emulator with TrueType fonts"
 url="https://salsa.debian.org/debian/fbterm"
@@ -13,6 +13,7 @@ subpackages="$pkgname-doc"
 source="https://deb.debian.org/debian/pool/main/f/fbterm/fbterm_$pkgver.orig.tar.gz
 	https://deb.debian.org/debian/pool/main/f/fbterm/fbterm_$pkgver-$_debrel.debian.tar.xz
 	musl-compat.patch
+	reserve-bottom.patch
 	"
 builddir="$srcdir/fbterm-$pkgver"
 
@@ -43,4 +44,5 @@ sha512sums="
 3d3135bf289ca39824958c50cc36ee7dd4fce69e9cfb6ea3a657a72159794b73a1fcfd196b899fcc5d3644f57fa265c03edb4c18db175d739c3507482b8e8acc  fbterm_1.7.orig.tar.gz
 4a8d2f999d95e334c5e6ac081e538d414f6285656db622bd33572eec46e15d94192bbf336c48d2172007f5b8e73b056f9571ae018d17d064523cf8e819623b2b  fbterm_1.7-5.debian.tar.xz
 a9f23806626bd2accf4b50e759f9cd6b4076353938c74ba6d1f461465754cebd47b7923e7c183ecea164fb8ae573a4f5e06c75be5222ec58176912b2e298c6fd  musl-compat.patch
+766fa8a23d416f3f79da8ce947e89ed2ae17c823b618ae90f47231046f156053bc905ce2724247d3223ab03c96ec7aa12a83c54a4d3866d441336dab1622ad98  reserve-bottom.patch
 "
diff --git a/main/fbterm/reserve-bottom.patch b/main/fbterm/reserve-bottom.patch
new file mode 100644
index 0000000000..fe196f5284
--- /dev/null
+++ b/main/fbterm/reserve-bottom.patch
@@ -0,0 +1,27 @@
+diff -ru a/src/fbdev.cpp b/src/fbdev.cpp
+--- a/src/fbdev.cpp	2026-11-01 19:22:53.821805914 +0100
++++ b/src/fbdev.cpp	2026-11-01 19:22:53.903933718 +0100
+@@ -91,12 +91,22 @@
+ {
+ 	mWidth = vinfo.xres;
+ 	mHeight = vinfo.yres;
++	/*
++	 * FBTERM_RESERVE_BOTTOM=<pixels> leaves a strip at the bottom of the
++	 * screen untouched, e.g. for an on-screen keyboard drawn by another
++	 * program (buffyboard). Panning would move that strip, so scroll by
++	 * redrawing instead.
++	 */
++	const char *reserve = getenv("FBTERM_RESERVE_BOTTOM");
++	u32 reserved = reserve ? strtoul(reserve, 0, 10) : 0;
++	if (reserved >= mHeight) reserved = 0;
++	mHeight -= reserved;
+ 	mBitsPerPixel = vinfo.bits_per_pixel;
+ 	mBytesPerLine = finfo.line_length;
+ 	mVMemBase = (u8 *)mmap(0, finfo.smem_len, PROT_READ | PROT_WRITE, MAP_SHARED, fbdev_fd, 0);
+ 
+ 
+-	if (mRotateType == Rotate0 || mRotateType == Rotate180) {
++	if (!reserved && (mRotateType == Rotate0 || mRotateType == Rotate180)) {
+ 		bool ypan = (vinfo.yres_virtual > vinfo.yres && finfo.ypanstep && !(FH(1) % finfo.ypanstep));
+ 		bool ywrap = (finfo.ywrapstep && !(FH(1) % finfo.ywrapstep));
+ 		if (ywrap && !(vinfo.vmode & FB_VMODE_YWRAP)) {
-- 
2.53.0

