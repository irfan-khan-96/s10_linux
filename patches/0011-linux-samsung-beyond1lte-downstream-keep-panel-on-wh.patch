--- /dev/null
+++ b/device/downstream/linux-samsung-beyond1lte-downstream/decon-keep-panel-on-release.patch
@@ -0,0 +1,37 @@
+decon: don't power off the panel when /dev/fb0 is closed
+
+Samsung's decon_release() turns the DSI panel off on every close of the
+framebuffer, which leaves the screen black on Linux. Only blank on FBIOBLANK.
+
+--- a/drivers/video/fbdev/exynos/dpu20/decon_core.c	2026-10-31 14:17:20.315273382 +0100
++++ b/drivers/video/fbdev/exynos/dpu20/decon_core.c	2026-10-31 14:17:20.373088382 +0100
+@@ -3685,7 +3685,6 @@
+ {
+ 	struct decon_win *win = info->par;
+ 	struct decon_device *decon = win->decon;
+-	int ret;
+ 
+ 	decon_info("%s + : %d\n", __func__, decon->id);
+ #if defined(CONFIG_SEC_DISPLAYPORT_LOGGER)
+@@ -3698,14 +3697,13 @@
+ 				decon->id, decon->out_sd[0]->name);
+ 	}
+ 
+-	if (decon->dt.out_type == DECON_OUT_DSI) {
+-		decon_hiber_block_exit(decon);
+-		ret = decon_update_pwr_state(decon, DISP_PWR_OFF);
+-		if (ret)
+-			decon_err("%s: decon%d failed to set DISP_PWR_OFF, ret %d\n",
+-					__func__, decon->id, ret);
+-		decon_hiber_unblock(decon);
+-	}
++	/*
++	 * Android keeps /dev/fb0 open in one process for its whole lifetime, so
++	 * powering the panel off on every release is harmless there. On Linux
++	 * many programs open and close the framebuffer (X, fbset, tests), and
++	 * each close would turn the screen off. Leave panel power to explicit
++	 * FBIOBLANK requests (screen blanking) instead.
++	 */
+ 
+ 	if (decon->dt.out_type == DECON_OUT_DP) {
+ 		/* Unused DECON state is DECON_STATE_INIT */
