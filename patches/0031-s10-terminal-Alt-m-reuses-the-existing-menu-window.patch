From e0a7e328f8c38fd1835de1e3b6b4ab1e2d77c66f Mon Sep 17 00:00:00 2001
From: khan <khan@localhost>
Date: Mon, 2 Nov 2026 00:34:52 +0100
Subject: [PATCH 31/43] s10-terminal: Alt+m reuses the existing menu window

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 device/downstream/s10-terminal/APKBUILD  | 4 ++--
 device/downstream/s10-terminal/tmux.conf | 5 +++--
 2 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/device/downstream/s10-terminal/APKBUILD b/device/downstream/s10-terminal/APKBUILD
index d9561a2021..721cf59146 100644
--- a/device/downstream/s10-terminal/APKBUILD
+++ b/device/downstream/s10-terminal/APKBUILD
@@ -2,7 +2,7 @@
 # setup that turns samsung-beyond1lte-downstream into a pocket terminal.
 pkgname=s10-terminal
 pkgver=1
-pkgrel=8
+pkgrel=9
 pkgdesc="Galaxy S10 pocket terminal: fbterm + tmux, on-screen keyboard, hardening"
 url="https://postmarketos.org"
 arch="aarch64"
@@ -74,7 +74,7 @@ f5b670528587d518a367b66ae15fd9b5583b7ad666e03051523cf56a1b007469fc5fad535f4d22b1
 9daf9ac5a89cd6d83560f26e35b95253ea71b20eeb3556ebdf31e2b7e4a66dfa4845c0f73c43601ac63f2e56613f17777691135d564f4924f23b9a3865838e6f  s10-osk-start
 9d1669d20e3eaf1c9138bbfc524e2ccfb63a1c26c33fee3d3416a2837c9a531c16c85a6c41da1c98d07fcee86c4e0d2f49230d6b77b98af29952f99a102b4c4f  s10-term
 57a90c056354401584f280ba2e94483dd08dc89fbbd643626f04a1d121ddd0c6a180efb477d863ecd4b2da95325ca8576d355c4467a774c39a08f594978e2675  fbtermrc
-19bfc40461acfaa8f7b17a90adad39bbf5fd5b78bb14edea7e9f41d99a79c8118760b39c28413f31a00c0f9a8cc74152dcd02ccd6531d8c4e6a438a6dec0fa39  tmux.conf
+f8338a07c5390a69e2850f84c659de62d0fa6901491c17c02be4ccc41b4c6774c73cb64182d16b9a0f9ed5c601dd7f6f2aada85889cd2c9ee6fd0a5d1f061558  tmux.conf
 2925ca72c125e154331429da14c4b2d515c0cb0b023cae521326f457d098a35ff58c78b5a32e2d950eacd2cb97e086c914e20067577232243c05baf72504df78  10-firewall.start
 0f7f7f1b2d71ca3c5b4082b82ce36f021c96ba8c14db74a4c552b8a931133dabdfdd69628a4d1830e84f2b0b1da40a8624ea100f548f782932fad2ad49846de3  20-display-on.start
 13ff9308e064e707cdf329b867d29ba7668e5662c36cc58212b1e13dbb4314c1e2d64b5ec2c9b6a0088f38c8d677162a7ecc1a4d7a488ff6ee86c3c8bf9680de  30-usb-dhcp.start
diff --git a/device/downstream/s10-terminal/tmux.conf b/device/downstream/s10-terminal/tmux.conf
index 303d8b70d9..6c36404f46 100755
--- a/device/downstream/s10-terminal/tmux.conf
+++ b/device/downstream/s10-terminal/tmux.conf
@@ -18,5 +18,6 @@ setw -g window-status-current-style "fg=white,bold"
 set -g pane-border-style "fg=colour236"
 set -g pane-active-border-style "fg=colour244"
 set -g message-style "bg=black,fg=white"
-# Alt+m: back to the launcher (reopened if it was closed)
-bind -n M-m if-shell "tmux list-windows -F '#W' | grep -qx menu" "select-window -t menu" "new-window -b -t 1 -n menu s10-menu"
+# Alt+m: back to the launcher (reopened if it was closed); ##W because tmux
+# expands formats in the if-shell command before the shell runs it
+bind -n M-m if-shell "tmux list-windows -F '##W' | grep -qx menu" "select-window -t menu" "new-window -b -t 1 -n menu s10-menu"
-- 
