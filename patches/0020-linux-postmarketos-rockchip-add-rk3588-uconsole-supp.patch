++	.htotal      = 720 + 30 + 15 + 15,
++	.vdisplay    = 1280,
++	.vsync_start = 1280 + 8,
++	.vsync_end   = 1280 + 8 + 2,
++	.vtotal      = 1280 + 8 + 2 + 16,
++	.width_mm    = 62,
++	.height_mm   = 110,
++	.type        = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED,
++};
++
++static inline struct cwu50 *panel_to_cwu50(struct drm_panel *panel)
++{
++	return container_of(panel, struct cwu50, panel);
++}
