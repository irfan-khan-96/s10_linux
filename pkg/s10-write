#!/bin/sh
# Writing: one place for notes and the journal, in distraction-free Neovim
# (setup in /usr/share/s10-terminal/write.lua). Everything lives in ~/notes,
# the journal in ~/notes/journal (one file per day).
#   s10-write            start screen: today's journal, new note, search, recent pieces
#   s10-write today      today's journal entry
#   s10-write <file>     any file
notes="$HOME/notes"
mkdir -p "$notes/journal"
# one-time move of the old ~/journal folder (never overwrites a file already there)
if [ -d "$HOME/journal" ]; then
	for f in "$HOME/journal"/* "$HOME/journal"/.[!.]*; do
		[ -e "$f" ] || continue
		[ -e "$notes/journal/${f##*/}" ] || mv "$f" "$notes/journal/"
	done
	rmdir "$HOME/journal" 2>/dev/null
fi
# NVIM_APPNAME: its own undo, swap and history, apart from the normal Neovim
export NVIM_APPNAME=s10-write
init=/usr/share/s10-terminal/write.lua
case "$1" in
"")     exec nvim -u "$init" ;;
today)  exec nvim -u "$init" -c 'lua vim.g.s10_today = 1; S10Today()' ;;
*)      exec nvim -u "$init" '+normal! G$' "$1" ;;
esac
