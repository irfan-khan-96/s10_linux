#!/bin/sh
# Wire up services, the tty1 terminal and the phone user's groups.
user=$(getent passwd 10000 | cut -d: -f1)
rc-update -q add local default
rc-update -q add s10-splash boot
rc-update -q add s10-idle-blank default
rc-update -q add s10-osk default
rm -f /var/cache/s10-terminal/splash.rgb565   # re-rendered on next boot
rc-update -q add msm-fb-refresher default
rc-update -q del unudhcpd.usb0 boot 2>/dev/null
rc-update -q add unudhcpd.rndis0 default
if [ -n "$user" ]; then
	for g in video input audio; do addgroup "$user" "$g" 2>/dev/null; done
	[ -f /etc/inittab.orig ] || cp /etc/inittab /etc/inittab.orig
	sed -i "s|^tty1::respawn:.*|tty1::respawn:/bin/su -l $user -c /usr/bin/s10-term|" /etc/inittab
	# no logins on tty2-6: nothing displays them, and switching there leaves fbterm without input
	sed -i "s|^tty[2-6]::|#&|" /etc/inittab
	kill -HUP 1 2>/dev/null
	# home file share: our config (the stock one stays as smb.conf.orig), its folder, the
	# service. The Samba password is set by hand once: sudo smbpasswd -a <user>
	if ! grep -q "S10 home file share v2" /etc/samba/smb.conf 2>/dev/null; then
		[ -f /etc/samba/smb.conf ] && [ ! -f /etc/samba/smb.conf.orig ] && cp /etc/samba/smb.conf /etc/samba/smb.conf.orig
		sed "s/@USER@/$user/g" /usr/share/s10-terminal/smb.conf > /etc/samba/smb.conf
		rc-service -q samba status && rc-service -q samba restart
	fi
	install -d -o "$user" -g "$user" "/home/$user/share"
	rc-update -q add samba default
fi
rc-update -q del s10-syncthing default 2>/dev/null
fc-cache -f /usr/share/fonts/s10-vt >/dev/null 2>&1
exit 0
