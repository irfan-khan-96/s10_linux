#!/bin/sh
# tmux status-right for the S10 terminal: Wi-Fi bars, battery (charging, low warning), clock.
# Prints tmux style codes in the amber palette (7 = text, 8 = dim, 15 = bright, 9 = warning).
B=/sys/class/power_supply/battery
cap=$(cat $B/capacity 2>/dev/null || echo 0)
status=$(cat $B/status 2>/dev/null)

signal=$(nmcli -t -f in-use,signal dev wifi list --rescan no 2>/dev/null | sed -n 's/^\*://p' | head -1)
if [ -z "$signal" ]; then
	wifi="#[fg=colour8]NO NET"
else
	wifi=""
	for t in 1 30 55 80; do
		if [ "$signal" -ge "$t" ]; then wifi="$wifi#[fg=colour7]"; else wifi="$wifi#[fg=colour8]"; fi
		case $t in 1) wifi="$wifi▂";; 30) wifi="$wifi▄";; 55) wifi="$wifi▆";; 80) wifi="$wifi█";; esac
	done
fi

if [ "$status" = Charging ] || [ "$status" = Full ]; then
	bat="#[fg=colour15]+$cap%"
elif [ "$cap" -le 15 ]; then
	bat="#[bg=colour9,fg=colour0] LOW $cap% #[bg=default]"
else
	bat="#[fg=colour7]$cap%"
fi

printf '%s  %s  #[fg=colour7]%s ' "$wifi" "$bat" "$(date +%H:%M)"
