# Local package for the S10 fork: terminal, on-screen keyboard and home-server
# setup that turns samsung-beyond1lte-downstream into a pocket terminal.
pkgname=s10-terminal
pkgver=1
pkgrel=23
pkgdesc="Galaxy S10 pocket terminal: fbterm + tmux, on-screen keyboard, hardening"
url="https://postmarketos.org"
arch="aarch64"
license="MIT AND OFL-1.1"
depends="
	fbterm
	font-jetbrains-mono
	iptables
	iptables-legacy
	iw
	less
	man-pages
	mandoc
	msm-fb-refresher
	nano
	ncurses-terminfo
	neovim
	py3-numpy
	py3-pillow
	python3
	samba
	samba-server-openrc
	strace
	tree
	tmux
	unudhcpd
	wordgrinder
	"
install="$pkgname.post-install $pkgname.post-upgrade"
options="!check"
source="
	s10-osk
	s10-menu
	s10-status
	s10-splash
	s10-splash.initd
	s10-osk.initd
	s10-idle-blank.initd
	s10-update
	s10-awake
	s10-idle-blank
	s10-touch-absfix
	s10-osk-start
	s10-term
	fbtermrc
	tmux.conf
	smb.conf
	05-s10-lpm.start
	10-firewall.start
	20-display-on.start
	30-usb-dhcp.start
	40-s10-tuning.start
	45-s10-battery.start
	90-s10-touch-absfix.rules
	unudhcpd.rndis0.confd
	wifi-powersave-off.conf
	sshd-hardening.conf
	S10VT-Regular.ttf
	61-s10-vt-crisp.conf
	OFL-VT323.txt
	"

package() {
	for f in s10-osk s10-menu s10-update s10-awake s10-status s10-splash s10-idle-blank s10-touch-absfix s10-osk-start s10-term; do
		install -Dm755 "$srcdir/$f" "$pkgdir/usr/bin/$f"
	done
	install -Dm755 "$srcdir"/s10-splash.initd "$pkgdir"/etc/init.d/s10-splash
	install -Dm755 "$srcdir"/s10-osk.initd "$pkgdir"/etc/init.d/s10-osk
	install -Dm755 "$srcdir"/s10-idle-blank.initd "$pkgdir"/etc/init.d/s10-idle-blank
	# S10 VT: VT323 (OFL-1.1) plus box/block glyphs, built by tools/build-font.py
	install -Dm644 "$srcdir"/S10VT-Regular.ttf "$pkgdir"/usr/share/fonts/s10-vt/S10VT-Regular.ttf
	install -Dm644 "$srcdir"/61-s10-vt-crisp.conf "$pkgdir"/etc/fonts/conf.d/61-s10-vt-crisp.conf
	install -Dm644 "$srcdir"/OFL-VT323.txt "$pkgdir"/usr/share/licenses/$pkgname/OFL-VT323.txt
	install -Dm644 "$srcdir"/fbtermrc "$pkgdir"/usr/share/s10-terminal/fbtermrc
	install -Dm644 "$srcdir"/tmux.conf "$pkgdir"/etc/tmux.conf
	install -Dm644 "$srcdir"/smb.conf "$pkgdir"/usr/share/s10-terminal/smb.conf
	for f in 05-s10-lpm 10-firewall 20-display-on 30-usb-dhcp 40-s10-tuning 45-s10-battery; do
		install -Dm755 "$srcdir/$f.start" "$pkgdir/etc/local.d/$f.start"
	done
	install -Dm644 "$srcdir"/90-s10-touch-absfix.rules \
		"$pkgdir"/usr/lib/udev/rules.d/90-s10-touch-absfix.rules
	install -Dm644 "$srcdir"/unudhcpd.rndis0.confd "$pkgdir"/etc/conf.d/unudhcpd.rndis0
	mkdir -p "$pkgdir"/etc/init.d
	ln -s unudhcpd "$pkgdir"/etc/init.d/unudhcpd.rndis0
	install -Dm644 "$srcdir"/wifi-powersave-off.conf \
		"$pkgdir"/etc/NetworkManager/conf.d/10-s10-wifi-powersave-off.conf
	install -Dm644 "$srcdir"/sshd-hardening.conf \
		"$pkgdir"/etc/ssh/sshd_config.d/10-hardening.conf
}

