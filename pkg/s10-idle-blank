#!/usr/bin/python3
# Turn the S10 panel off after IDLE seconds without input, or at once with the power
# button, and back on at the first key press, touch or button (USB keyboards may be
# plugged in at any time).
# DIM seconds before that the backlight drops to a fifth, so the screen fades
# instead of cutting out; any input restores it.
#
# While the screen is off the phone stays reachable (SSH, Samba) but saves power:
# the display refresher and screen-only monitors (htop, top) are paused, cores 4-7
# go offline, Wi-Fi power saving is on, the touch booster and tmux status polling
# are off. Everything is restored on wake. Battery readings are logged every 15 min
# while off to /var/log/s10-power.log, to check the standby drain.
#
# Deep sleep: while the screen is off the phone suspends to RAM whenever nothing holds it
# awake. The kernel itself refuses to suspend while Wi-Fi traffic is in flight, so an
# active SSH or Samba session keeps it up; a new packet from the network, a button or the
# clock (every 15 min, for the battery log and low-battery check) wakes it. Touch does not
# wake it from sleep; a button does. "0" in /etc/s10-deep-sleep turns sleep off;
# s10-awake <command> keeps the phone up while a long job runs.
import glob, os, select, struct, subprocess, time

IDLE = int(os.environ.get("S10_IDLE_SECONDS", "120"))
DIM = 10
BLANK = "/sys/class/graphics/fb0/blank"
BACKLIGHT = "/sys/class/backlight/panel/brightness"
BATTERY = "/sys/class/power_supply/battery"
POWER_LOG = "/var/log/s10-power.log"
LOW_BATTERY = 3                                # % on battery: clean poweroff
EV_KEY, EV_REL, EV_ABS, KEY_POWER = 1, 2, 3, 116
BIG_CORES = (4, 5, 6, 7)                       # mid (A75) and big (M4) clusters
# Frozen while the screen is off. Names as in /proc/<pid>/comm, which the kernel cuts
# to 15 characters. They are frozen with the cgroup-v1 freezer, not SIGSTOP: tmux sends
# SIGCONT to a pane process as soon as it sees it stopped.
PAUSE_WHEN_OFF = ("msm-fb-refreshe", "htop", "top", "btop")
FREEZER = "/run/s10-freezer"
TMUX = ["tmux", "-S", "/tmp/tmux-10000/default"]
SLEEP_SETTING = "/etc/s10-deep-sleep"          # "0" = never suspend
STAY_AWAKE = "/run/s10-stay-awake"             # a file in here holds off sleep (s10-awake)
RTC_ALARM = "/sys/class/rtc/rtc0/wakealarm"
AWAKE_AFTER_WAKE = 5                           # s up after each wake before trying again
RETRY = 3                                      # s between refused suspend attempts
LOG_EVERY = 900                                # s between battery log lines while off

def clock():
    '''Seconds since boot, counting time spent asleep (time.monotonic stops in suspend).'''
    return time.clock_gettime(time.CLOCK_BOOTTIME)

def read(path, default=None):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default

def write(path, value):
    try:
        with open(path, "w") as f:
            f.write(value)
    except OSError:
        pass

def backlight(value=None):
    if value is None:
        v = read(BACKLIGHT)
        return int(v) if v and v.isdigit() else None
    write(BACKLIGHT, str(value))

def run(*args):
    subprocess.run(args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def freezer():
    """Mount the (otherwise unused) cgroup-v1 freezer and return its 'paused' group."""
    group = f"{FREEZER}/paused"
    if not os.path.exists(f"{group}/freezer.state"):
        os.makedirs(FREEZER, exist_ok=True)
        if FREEZER not in read("/proc/mounts", ""):
            run("mount", "-t", "cgroup", "-o", "freezer", "s10-freezer", FREEZER)
        os.makedirs(group, exist_ok=True)
    return group

def freeze(on):
    group = freezer()
    if on:
        for d in glob.glob("/proc/[0-9]*"):
            if read(f"{d}/comm") in PAUSE_WHEN_OFF:
                write(f"{group}/cgroup.procs", os.path.basename(d))
    write(f"{group}/freezer.state", "FROZEN" if on else "THAWED")

def power_saving(on):
    """Screen off: pause what only matters on screen and idle the hardware. Off: undo."""
    if not on:                                 # cores and refresher first, so waking feels instant
        for c in BIG_CORES:
            write(f"/sys/devices/system/cpu/cpu{c}/online", "1")
    freeze(on)
    if on:
        for c in BIG_CORES:
            write(f"/sys/devices/system/cpu/cpu{c}/online", "0")
    run("iw", "dev", "wlan0", "set", "power_save", "on" if on else "off")
    write("/sys/class/input_booster/enable_event", "0" if on else "1")
    run(*TMUX, "set", "-g", "status-interval", "0" if on else "15")

STATE = "/run/s10-blanked"  # "1" while off, "0" just after waking (read by s10-osk)

def write_blank(value):
    with open(BLANK, "w") as f:
        f.write(value)

def set_blank(off, cycle=True):
    if off:
        write_blank("1")
    elif cycle:
        # A plain unblank after a long blank can leave the panel dark (the driver
        # accepts it but DSIM stays off); off, 1 s for the panel to finish powering
        # down (0.3 s was too short), then on wakes it.
        write_blank("1")
        time.sleep(1.0)
        write_blank("0")
    else:
        write_blank("0")
    with open(STATE, "w") as f:
        f.write("1" if off else "0")

def suspend(seconds):
    '''Suspend to RAM with a clock wake-up in `seconds`. Returns True once awake again;
    False if the kernel refused (a wakeup source was active) or sleep is off or held.'''
    if read(SLEEP_SETTING, "1") == "0":
        return False
    try:
        if os.listdir(STAY_AWAKE):
            return False
    except OSError:
        pass
    write(RTC_ALARM, "0")
    write(RTC_ALARM, f"+{max(int(seconds), 30)}")
    try:
        with open("/sys/power/state", "w") as f:
            f.write("mem")
        return True
    except OSError:
        return False
    finally:
        write(RTC_ALARM, "0")

def log_power():
    # this fuel gauge reports current_avg in mA (negative while discharging)
    line = (f"{time.strftime('%Y-%m-%d %H:%M')} {read(BATTERY + '/capacity', '?')}% "
            f"{read(BATTERY + '/status', '?')} avg {read(BATTERY + '/current_avg', '?')} mA"
            f" sleeps {read('/sys/power/suspend_stats/success', '?')}\n")
    try:
        lines = open(POWER_LOG).readlines()[-2000:] if os.path.exists(POWER_LOG) else []
        with open(POWER_LOG, "w") as f:
            f.writelines(lines + [line])
    except OSError:
        pass

def open_inputs(fds):
    for path in glob.glob("/dev/input/event*"):
        if path not in fds:
            try:
                fds[path] = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
            except OSError:
                pass

os.makedirs(STAY_AWAKE, exist_ok=True)
os.chmod(STAY_AWAKE, 0o1777)                   # any user's s10-awake can hold it
fds, blanked, last, next_log = {}, False, clock(), 0
next_sleep = 0
dimmed = None  # brightness to restore while dimmed
set_blank(False, cycle=False)
power_saving(False)
while True:
    open_inputs(fds)  # pick up hot-plugged keyboards
    # screen off: wake rarely (input still wakes select at once)
    ready, _, _ = select.select(list(fds.values()), [], [], RETRY if blanked else 1)
    activity = power = False
    for fd in ready:
        try:
            data = os.read(fd, 4096)
        except OSError:  # device unplugged
            for path, f in list(fds.items()):
                if f == fd:
                    os.close(f)
                    del fds[path]
            continue
        for i in range(0, len(data) - 23, 24):
            _, _, etype, code, value = struct.unpack_from("qqHHi", data, i)
            if etype == EV_KEY and code == KEY_POWER:
                power = power or value == 1    # press only; its release is not activity
            elif etype in (EV_KEY, EV_REL, EV_ABS):
                activity = True
    now = clock()
    if power and blanked:
        activity = True                        # power button wakes like any key
    if power and not blanked:                  # power button: screen off now
        set_blank(True)
        power_saving(True)
        blanked = True
        next_log = now
        next_sleep = now + 10
    elif activity:
        last = now
        if blanked:
            power_saving(False)
            set_blank(False)
            blanked = False
        if dimmed is not None:  # after waking: the panel takes the level once it is on
            backlight(dimmed)
            dimmed = None
    elif not blanked and now - last >= IDLE:
        set_blank(True)
        power_saving(True)
        blanked = True
        next_log = now
        next_sleep = now + 10
    elif not blanked and dimmed is None and now - last >= IDLE - DIM:
        dimmed = backlight()
        if dimmed is not None:
            backlight(max(dimmed // 5, 200))
    if now >= next_log:
        if blanked:
            log_power()
        # flat battery: shut down cleanly instead of losing power mid-write
        cap = read(BATTERY + "/capacity", "100")
        if read(BATTERY + "/status") == "Discharging" and cap.isdigit() and int(cap) <= LOW_BATTERY:
            log_power()
            run("poweroff")
        next_log = now + (LOG_EVERY if blanked else 300)
    if blanked and not activity and now >= next_sleep:
        if suspend(next_log - now):
            next_sleep = clock() + AWAKE_AFTER_WAKE
        else:
            next_sleep = clock() + RETRY
