#!/usr/bin/python3
# Boot splash: switch the panel on and show a logo until fbterm takes over.
# The image is rendered once (Pillow is slow to import) and cached as raw RGB565.
# Drawing goes through mmap (the decon driver ignores write()); a pan ioctl makes
# the panel show it before msm-fb-refresher runs.
import fcntl, mmap, os

W, H = 1440, 3040
LL = W * 2
CACHE = "/var/cache/s10-terminal/splash.rgb565"
FONT = "/usr/share/fonts/s10-vt/S10VT-Regular.ttf"
AMBER, DIM, BG = (244, 178, 64), (128, 88, 26), (5, 2, 0)

def render():
    """Amber 'BIOS' screen in the terminal's font, with the same scanlines as fbterm."""
    import numpy as np
    from PIL import Image, ImageDraw, ImageFont
    img = Image.new("RGB", (W, H), BG)
    d = ImageDraw.Draw(img)
    d.fontmode = "1"                  # no smoothing: hard pixel edges, like the terminal
    big, text = ImageFont.truetype(FONT, 300), ImageFont.truetype(FONT, 75)
    d.text((W / 2, 900), "S10", font=big, fill=AMBER, anchor="mm")
    d.rectangle((120, 1120, W - 120, 1126), fill=DIM)
    lines = [("POCKET TERMINAL", AMBER), ("", None),
             ("CPU   EXYNOS 9820 (8 CORES)", DIM), ("OS    POSTMARKETOS EDGE", DIM),
             ("KERN  LINUX 4.14 DOWNSTREAM", DIM), ("TERM  FBTERM + TMUX", DIM), ("", None),
             ("BOOTING", AMBER)]
    y = 1200
    for line, colour in lines:
        if line:
            d.text((160, y), line, font=text, fill=colour)
        y += 90
    d.rectangle((160 + 8 * 30 + 3, y - 90 + 9, 160 + 9 * 30 - 3, y - 90 + 75), fill=AMBER)   # cursor
    rgb = np.asarray(img, dtype=np.uint16)
    px = (((rgb[..., 0] >> 3) << 11) | ((rgb[..., 1] >> 2) << 5) | (rgb[..., 2] >> 3)).astype("<u2")
    try:
        with open("/etc/s10-scanlines") as f:
            n = int(f.read())
    except (OSError, ValueError):
        n = 3
    if n >= 2:
        px[n - 1::n] = (px[n - 1::n] >> 1) & 0x7BEF
    data = px.tobytes()
    os.makedirs(os.path.dirname(CACHE), exist_ok=True)
    with open(CACHE, "wb") as f:
        f.write(data)
    return data

try:
    with open(CACHE, "rb") as f:
        data = f.read()
except OSError:
    data = render()

with open("/sys/class/graphics/fb0/blank", "w") as f:
    f.write("0")
fd = os.open("/dev/fb0", os.O_RDWR)
fb = mmap.mmap(fd, LL * H, mmap.MAP_SHARED, mmap.PROT_READ | mmap.PROT_WRITE)
fb[0:LL * H] = data
var = bytearray(160)
fcntl.ioctl(fd, 0x4600, var)                       # FBIOGET_VSCREENINFO
fcntl.ioctl(fd, 0x4606, var)                       # FBIOPAN_DISPLAY: push the frame out
